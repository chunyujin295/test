QString ImportGcpDlg::getSelectIndex()
{
	if (coordinate == "")
		return	coordinate = ui.comboBox->itemText(0);
	else
		return coordinate;
}

void ImportGcpDlg::setIndexString(QStringList strList)
{
	ui.comboBox->clear();
	ui.comboBox->addItems(strList);
	
}



