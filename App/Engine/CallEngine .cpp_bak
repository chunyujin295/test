void customized_exit()
{
	printf("exit main to execute\n");
	LOGI("exit main to execute");

	PostQuitProcess();

}

int minSfmMemory = -1; // unit:GB

std::map<std::string, int> jobSfmMemoryMap;

// 获取本机物理内存(单位:GB)
int TestSfmMemory(std::string taskJsonFile)
{
	int MB = 1024 * 1024;
	int GB = 1024 * 1024 * 1024;
	int HalfGB = 512 * 1024 * 1024;

	MEMORYSTATUSEX memoryStatusEx;
	memoryStatusEx.dwLength = sizeof(memoryStatusEx);

	GlobalMemoryStatusEx(&memoryStatusEx);

	int allMemoryMB = memoryStatusEx.ullTotalPhys / MB;
	int freeMemoryMB = memoryStatusEx.ullAvailPhys / MB;

	int allMemory = (memoryStatusEx.ullTotalPhys  + HalfGB) / GB;
	int freeMemory = (memoryStatusEx.ullAvailPhys + HalfGB) / GB;

	// 获取并设置当前主机物理内存(GB).
	enginePhysicalMemory = allMemory;




	return 0;
}
//engine启动时创建文件夹
void MakePath();
void MakePath()
{
	if (!JobMonitor::CreateJobQueueDir(ENGINEJOBPATH))
	{
		// try the local job directory within current applicaton's working directory.
		JobMonitor::CreateLocalJobQueueDir();
		JobMonitor::CreateJobQueueDir(ENGINEJOBPATH);
	}

	pathSeperator = "/";
	pendingJobPath = Settings::getEngineJobQueue() + pathSeperator + JOBPENDINGSTR + pathSeperator ;
	runningJobPath = Settings::getEngineJobQueue() + pathSeperator + JOBRUNNINGSTR + pathSeperator;
	completedJobPath = Settings::getEngineJobQueue() + pathSeperator + JOBCOMPLETEDSTR + pathSeperator;
	failedJobPath = Settings::getEngineJobQueue() + pathSeperator + JOBFAILEDSTR + pathSeperator;
	cancelledJobPath = Settings::getEngineJobQueue() + pathSeperator + JOBCANCELLEDSTR + pathSeperator;
}

//定时输出engine信息，以广播engine的状态

// may change the tasktimefile to enginetime later in order to simplify dectecting and calculating the freshest taskfile status,
// especially for one taskfile may be captured by more than one engine at the same time occasionally.


void execEngineTimeThread()
{
	while (true)
	{
		if (engineinfofile.empty())
			break;

		if (bQuitingApplication)
			break;

		bWorkingOnEngineFile = true;

		EngineInfo_s runinfo;
		runinfo.HostName = QHostInfo::localHostName().toStdString();
		runinfo.UserName = getenv("USERNAME");
		runinfo.StartTime = enginestarttime.toStdString();
		runinfo.Status = 0;
		runinfo.Version = versionName;
		runinfo.IPAddr = get_local_ip().toStdString();
		runinfo.EndTime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss").toStdString();
		runinfo.ProcessId = qApp->applicationPid();


		runinfo.TaskFile2 = qstr2str(NewFileForRun);
		runinfo.TaskFile = GBK2UTF8(runinfo.TaskFile2);


		// what about taskfile status?

		//if (gotNewPendingJobFile && !NewFileForRun.isEmpty() && projectfilefullpath != "")

//		if (bQuitingApplication)
//			break;

//		if (engineinfofile.empty())
//			break;
		
		if ((gotNewPendingJobFile /*|| !NewFileForRun.isEmpty()*/) && projectfilefullpath != "")
		{
			runinfo.Status = 1;

			runinfo.ProjectName2 = projectfilefullpath;
			runinfo.ProjectName = GBK2UTF8(runinfo.ProjectName2);

		}

///		std::string enginelockfile = engineinfofile + LOCKFILE_POSTFIX;
///		if (enginelockfile=="")
///		{
///			break;
///		}
 
		if (!engineinfofile.empty() && !bQuitingApplication)
		{
			runinfo.save(engineinfofile);
		}

		bWorkingOnEngineFile = false;
		// reduce sleeping time from 2s to 1s for capturing a quicker status. 
		Sleep(1000);
	}
}

struct TaskTimeInfo
{
	QString sLastActiveTime;
	qint64 iTaskPid;
	QString sTaskFile;
};

bool checkTaskInstanceStatus(QString& sTmpNewFileForRun)
{
	qint64 iTaskPid = qApp->applicationPid();

	if (bQuitingApplication)
		return false;

	if (sTmpNewFileForRun.isEmpty())
		return false;

	if (!QFileInfo::exists(sTmpNewFileForRun))
		return false;

	QString sTaskPidFile = sTmpNewFileForRun + ".pid";

	if (!QFileInfo::exists(sTaskPidFile))
		return true;

	// Reaching here means it has ever run by some engine before.

	bool bSuccessfullyLoadedFromTaskTimeFile = false;

	TaskTimeInfo _taskTimeInfo;

	// qjson gbk? utf8?
	QFile fileTaskTimeInfo(sTaskPidFile);
	if (fileTaskTimeInfo.open(QIODevice::ReadOnly))
	{
		QByteArray baTaskTimeInfo = fileTaskTimeInfo.readAll();
		QJsonParseError errorTaskTimeInfo;

		QJsonDocument jsonDoc = QJsonDocument::fromJson(baTaskTimeInfo, &errorTaskTimeInfo);
		if (errorTaskTimeInfo.error == QJsonParseError::NoError && !jsonDoc.isNull())
		{
			//_taskTimeInfo = jsonDoc.
			QJsonObject jsonObj = jsonDoc.object();
			if (jsonObj.contains("taskPid") && jsonObj.contains("taskFile") && jsonObj.contains("lastActiveTime"))
			{
				_taskTimeInfo.iTaskPid = jsonObj.value("taskPid").toInt();
				_taskTimeInfo.sTaskFile = jsonObj.value("taskFile").toString();
				_taskTimeInfo.sLastActiveTime = jsonObj.value("lastActiveTime").toString();

				bSuccessfullyLoadedFromTaskTimeFile = true;
			}
		}

		fileTaskTimeInfo.close();

		if (bSuccessfullyLoadedFromTaskTimeFile)
		{
			// calculate the time difference which is from the last active time to now?
			QDateTime dtLastActiveTime = QDateTime::fromString(_taskTimeInfo.sLastActiveTime, "yyyyMMddhhmmss");
			QDateTime dtNow = QDateTime::currentDateTime();
			int diffSecs = dtLastActiveTime.secsTo(dtNow);

			if (iTaskPid == _taskTimeInfo.iTaskPid)
			{
				// same instance running on same host machine compared with previous one.
				if (diffSecs > 3)
					return true;
				else
					return false;
			}
			else
			{
				// different running instance on same host machine or across different host machine compared with previous one.
				if (diffSecs > 10) 
					return true;
				else
					return false;
			}
		}
		else
		{
			return true;
		}
	}
	else
		return true;
}

