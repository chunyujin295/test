void DoCleanupJobLockOnceWhileEngineStart()
{
	//QString lockFile = "D:\\worksp\\测试job目录\\Pending\\Highjob_20230526171137_AT.json.lock";

	QString lsPendingHighJobPath = pendingJobPath + pathSeperator + "High"; 
	QString lsRunningJobPath = runningJobPath; 

	QDir pendingHighDir(lsPendingHighJobPath);
	QDir runningDir(lsRunningJobPath);

	QStringList toBeRemovedFileList;

	if(pendingHighDir.exists())
	{
		QFileInfoList fileInfoList = pendingHighDir.entryInfoList(QDir::NoDotAndDotDot | QDir::Files);
		foreach(QFileInfo fileInfo, fileInfoList)
		{
			if (!fileInfo.suffix().compare("lock", Qt::CaseInsensitive))
			{
				QString jobJson = fileInfo.absolutePath() + pathSeperator + fileInfo.baseName() + ".json";
				if (!QFileInfo(jobJson).exists())
				{
					toBeRemovedFileList.append(fileInfo.absoluteFilePath());
				}
			}
		}
	}

	if (runningDir.exists())
	{
		QFileInfoList fileInfoList = runningDir.entryInfoList(QDir::NoDotAndDotDot|QDir::Files);
		foreach(QFileInfo fileInfo, fileInfoList)
		{
			if (!fileInfo.suffix().compare("lock", Qt::CaseInsensitive))
			{
				QString jobJson = fileInfo.absolutePath() + pathSeperator + fileInfo.baseName() + ".json";
				if (!QFileInfo(jobJson).exists())
				{
					toBeRemovedFileList.append(fileInfo.absoluteFilePath());
				}
			}
		}
	}

	foreach(QString filePath, toBeRemovedFileList)
	{
		QFile(filePath).remove();
	}
}

void DoCleanupLockFiles()
{
	while (true)
	{
		if (bQuitingApplication)
			return;

		QStringList deleteJobs;

		for (auto& it : toBeCleanedJobMap.toStdMap())
		{
			QString jobName = it.first;
			QString jobProjectBlockPath = it.second;

			if (hasFinishedJobMap.contains(jobName))
			{
				int jobState = hasFinishedJobMap[jobName];
				//std::cout << qstr2str(jobName) << " state:" << jobState << std::endl;

				if (jobState >= 2)
				{
					// for jobState,0:pending 1:running 2:completed 3:cancelled 4:failed.
					//  1) delete task.pid and task.lock inside project-block-job directory.
					//  2) delete job's lock file inside job queue including running and pending.

///					std::string job_file = Settings::getEngineJobQueue().toStdString() + "/Running/" + attask.job_ + ".json";
///					std::string feedbakpath = AI3D::CORE::File::GetParentDir(attask.projectFile_) + "/" + attask.blockItem_ + "/";// "feedback_" + attask.job_ + ".json";
///					std::string current_feedback_file = MAKE_FEEDBAK_FILE(feedbakpath, attask.job_);// AI3D::CORE::File::GetParentDir(attask.projectFile_) + "/" + attask.blockItem_ + "/" + feedname;
///					QString jobFileName = QString::fromStdString(job_file);
///					QString lsRunningJobFileName = QFileInfo(jobFileName).fileName();

					QString lsRunningJobFileName = jobName + ".json";

					QString lsPendingJobFile = pendingJobPath + pathSeperator + "High" + pathSeperator + lsRunningJobFileName;
					QString lsRunningJobFile = runningJobPath + pathSeperator + lsRunningJobFileName;

					QString lsPendingJobFileLock = lsPendingJobFile + ".lock";
					QString lsRunningJobFileLock = lsRunningJobFile + ".lock";

					QString lsCompletedJobFile = completedJobPath + pathSeperator + lsRunningJobFileName;;
					QString lsCancelledJobFile = cancelledJobPath + pathSeperator + lsRunningJobFileName;
					QString lsFailedJobFile = failedJobPath + pathSeperator + lsRunningJobFileName;

					if (QFileInfo(lsPendingJobFile).exists() || QFileInfo(lsRunningJobFile).exists())
					{
						// impossible,some errors must occur.
					}
					else if(QFileInfo(lsCompletedJobFile).exists() || QFileInfo(lsCancelledJobFile).exists() || QFileInfo(lsFailedJobFile).exists())
					{
						if (QFileInfo(lsPendingJobFileLock).exists())
						{
							QFile(lsPendingJobFileLock).remove();
						}

						if (QFileInfo(lsRunningJobFileLock).exists())
						{
							QFile(lsRunningJobFileLock).remove();
						}

						// delete task.pid / task.lock.

						QDir dir(jobProjectBlockPath);
						if (dir.exists())
						{
							QFileInfoList entries = dir.entryInfoList(QDir::NoDotAndDotDot|
							QDir::Files);

							foreach(QFileInfo entryInfo, entries)
							{
								// in fact,don't need to make such a check,for having limited the conditions without dirs inside
								// when searching parent dir.
								if (!entryInfo.isDir())
								{
									QString taskPath = entryInfo.absoluteFilePath();
									if (taskPath.endsWith(".pid") || taskPath.endsWith(".lock"))
									{
										QFile(taskPath).remove();
									}
								}
							}
						}

						deleteJobs.append(jobName);
					}
				}
			}
		}

		for (auto& job : deleteJobs)
		{
			hasFinishedJobMap.remove(job);
			toBeCleanedJobMap.remove(job);
		}

		// delay about at least 500 msecs.
		std::this_thread::sleep_for(std::chrono::milliseconds(1000));
	}
}

void DoCleaningUpLocks4OneJobFile(QString oldJobFile,QString newJobFile,jobsta_e newJobStatus)
{
	// Clean up all the locks generated for one specific job file at one time,including pending queue,running queue,feedback file,and all the job's task  related.
	// Only do cleaning-up works on locks for one job file which has already been moved successfully into 
	// new job queue directory,and surely the same job file which has disappeared from its original location inside specific job queue.

	// single dedicated thread,or placed every where at the place where one job file 
	if (newJobStatus == jobsta_e::STATUS_RUNNING)
	{
		// moved from pending job queue to running one.
	}
	else if (newJobStatus == jobsta_e::STATUS_CANCLE)
	{
		// to cancelled job queue,maybe from pending one ,or from running one.
	}
	else if (newJobStatus == jobsta_e::STATUS_FAILURE)
	{
		// from running job queue to failed one.
	}
	else if (newJobStatus == jobsta_e::STATUS_COMPLETE)
	{
		// from running job queue to completed one.
	}
	else
	{
		std::cout << "unexpected job status,check it please!" << std::endl;
		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << __FUNCTION__ << " LINE " << __LINE__ << " unexpected job status,check it please!";
			LOGI(oss.str());
		}
	}
}

//QSettings *sets = nullptr;
int GenerateMiniDump(PEXCEPTION_POINTERS pExceptionPointers)
{
	// 定义函数指针
	typedef BOOL(WINAPI* MiniDumpWriteDumpT)(
		HANDLE,
		DWORD,
		HANDLE,
		MINIDUMP_TYPE,
		PMINIDUMP_EXCEPTION_INFORMATION,
		PMINIDUMP_USER_STREAM_INFORMATION,
		PMINIDUMP_CALLBACK_INFORMATION
		);
	// 从 "DbgHelp.dll" 库中获取 "MiniDumpWriteDump" 函数
	MiniDumpWriteDumpT pfnMiniDumpWriteDump = NULL;
	HMODULE hDbgHelp = LoadLibraryA("DbgHelp.dll");
	if (NULL == hDbgHelp)
	{
		return EXCEPTION_CONTINUE_EXECUTION;
	}
	pfnMiniDumpWriteDump = (MiniDumpWriteDumpT)GetProcAddress(hDbgHelp, "MiniDumpWriteDump");

	if (NULL == pfnMiniDumpWriteDump)
	{
		FreeLibrary(hDbgHelp);
		return EXCEPTION_CONTINUE_EXECUTION;
	}
	// 创建 dmp 文件件
	char szFileName[MAX_PATH] = { 0 };
	char* szVersion = "Dump2Engine";
	SYSTEMTIME stLocalTime;
	GetLocalTime(&stLocalTime);
	sprintf(szFileName, "%s-%04d%02d%02d-%02d%02d%02d.dmp",
		szVersion, stLocalTime.wYear, stLocalTime.wMonth, stLocalTime.wDay,
		stLocalTime.wHour, stLocalTime.wMinute, stLocalTime.wSecond);
	HANDLE hDumpFile = CreateFileA(szFileName, GENERIC_READ | GENERIC_WRITE,
		FILE_SHARE_WRITE | FILE_SHARE_READ, 0, CREATE_ALWAYS, 0, 0);
	if (INVALID_HANDLE_VALUE == hDumpFile)
	{
		FreeLibrary(hDbgHelp);
		return EXCEPTION_CONTINUE_EXECUTION;
	}
	// 写入 dmp 文件
	MINIDUMP_EXCEPTION_INFORMATION expParam;
	expParam.ThreadId = GetCurrentThreadId();
	expParam.ExceptionPointers = pExceptionPointers;
	expParam.ClientPointers = FALSE;
	pfnMiniDumpWriteDump(GetCurrentProcess(), GetCurrentProcessId(),
		hDumpFile, MiniDumpWithDataSegs, (pExceptionPointers ? &expParam : NULL), NULL, NULL);
	// 释放文件
	CloseHandle(hDumpFile);
	FreeLibrary(hDbgHelp);
	return EXCEPTION_EXECUTE_HANDLER;
}

LONG WINAPI ExceptionFilter(LPEXCEPTION_POINTERS lpExceptionInfo)
{
	// 这里做一些异常的过滤或提示
	std::cout << "has come to ExceptionFilter" << std::endl;
	LOGI("has come to ExceptionFilter");

	///std::this_thread::sleep_for(std::chrono::milliseconds(30000));

	bQuitingApplication = true;

	///std::cout << "has come to ExceptionFilter2" << std::endl;
	///LOGI("has come to ExceptionFilter2");

	///std::this_thread::sleep_for(std::chrono::milliseconds(20000));

	///std::cout << "has come to ExceptionFilter3" << std::endl;
	///LOGI("has come to ExceptionFilter3");

	if (bSpecialLog)
	{
		std::ostringstream oss;
		oss.clear();
		oss << __FUNCTION__ << " LINE " << __LINE__ << "ExceptionFilter";
		LOGI(oss.str());
	}

	if (IsDebuggerPresent())
	{
		return EXCEPTION_CONTINUE_SEARCH;
	}
	return GenerateMiniDump(lpExceptionInfo);
}

