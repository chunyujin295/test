					//			if (bSpecialLog)
					//			{
					//				std::ostringstream oss;
					//				oss.clear();
					//				oss << __FUNCTION__ << " LINE " << __LINE__ << "  " << "failed to save feedback with complete status.";
					//				LOGI(oss.str());
					//			}
					//		}

					//		LOGI("after remove jobfile:" + qstr2str(jobFileName) + " taskfile:" + qstr2str(NewFileForRun));

					//		init();
					//		fclose(fp);
					//		///						QFile(jobFilePathLock).remove();



					//	}
					//}
					//else
					{
						feadback.Msg = atparam.task_.msg_;
						feadback.save_with_retry(feedback_file);

						// check it later:how about the job completion of the entire job?
						jobinfo.tg.tasksmap.at(taskid).Status = jobsta_e::STATUS_COMPLETE;
						jobinfo.tg.tasksmap.at(taskid).Percent = float(COMPLETE_PROGRESS);
						bool bsave = jobinfo.save(jobdirstr);
						std::ostringstream strLine;
						strLine.clear();
						strLine << "print time sum now " << __FUNCTION__ << " LINE " << __LINE__;
						PrintTimeSum(strLine.str());
						ExportTimeSum(jobinfo);
						init();

						LOGI("save jobfile:" + jobdirstr + " taskfile:" + qstr2str(NewFileForRun) + " resultCode:" + std::to_string(resultCode));

						fclose(fp);

					}

					return resultCode;
				}

			}
			else
			{
				std::cout << "---===--" << std::endl;
				LOGI("jobfile:" + jobdirstr + " taskfile:" + qstr2str(NewFileForRun));
				init();
				Sleep(30);
				return -1;
			}
		}
	}
	else //(type != ATCOMPLETETYPE)
	{
		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << " " << qstr2str(NewFileForRun) << " type " << type;;
			LOGI(oss.str());

		}
		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
		/*killTaskProcess();*/
		QString timenow = (QDateTime::currentDateTime()).toString("yyyy-MM-dd hh:mm:ss.zzz");
		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << __FUNCTION__ << " LINE " << __LINE__ << " " << "[" << timenow.toStdString() << "] Engine: Run Task ";
			LOGI(oss.str());
		}

		std::cout << "[" << timenow.toStdString() << "] Engine: Run Task " << std::endl;
		// 启动Motask.exe进程,执行传入的task json任务.
		path.append("/MoldAITask.exe");

		QStringList argumentList;

		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
		argumentList << NewFileForRun;

		qint64 pid = -1;

		QProcess process;

		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << "start " << qstr2str(NewFileForRun);
			LOGI(oss.str());
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
		}

		QObject::connect(&process, &QProcess::readyRead, [&] {
			while (process.canReadLine())
			{
				QString strTaskOutput = process.readLine();
				std::cout << "[MoTask]" << qstr2str(strTaskOutput);// << std::endl;

				if (strTaskOutput.contains("Exception:", Qt::CaseSensitive))
				{
					exceptionMsg = strTaskOutput;
				}
			}
			});

		hasFinishedJobMap.insert(str2qstr(jobname), 1);

		//chy 为啥是startdetached,不是start,非阻塞，后续可以边执行边更新日志
		//motask写log，eingine同步读

		///process.startDetached(path, argumentList, workingDirectory, &pid);

		///std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " before task start" << std::endl;
		///process.setWorkingDirectory(workingDirectory);
		
		std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
		process.start(path, argumentList);

		int state = 0;
		// 等待Motasak.exe进程启动成功
		bool suce = process.waitForStarted(-1);

		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << " " << qstr2str(NewFileForRun) << " succ " << suce;
			LOGI(oss.str());
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
			///std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " after task start:" << path.toStdString() << std::endl;
		}

		if (!suce)
		{
			std::ostringstream oss;
			oss.clear();
			oss << " " << qstr2str(NewFileForRun) << " start failed." << suce;
			LOGI(oss.str());
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;

			///std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " task start failed." << std::endl;

			if (fpTaskLock != NULL)
			{
				fclose(fpTaskLock);
				fpTaskLock = NULL;
				LOGI(qstr2str(NewFileForRun) + "start failed,release task file lock.");
			}

			return -1;
		}

		///process.close();
		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			///	oss << __FUNCTION__ << " LINE " << __LINE__ << " " << NewFileForRun.toStdString() << " close " << suce;
			oss << qstr2str(NewFileForRun) << " started successfully." << suce;


			LOGI(oss.str());

			///std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " task started successfully." << std::endl;
		}

		///if (bTestTaskKill4RunningTooLong);
		///dtTestTaskKillStart = QDateTime::currentDateTime();

		///taskPid = process.processId();
		///taskPidFile = NewFileForRun + ".pid";

		taskrunning = true;

		std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
		process.waitForFinished(-1);
		int iTaskRetVal = -1;

		//std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " wait for finished:" << std::endl;

		if (process.exitStatus() == QProcess::NormalExit)
		{
			// normally exited.
		//	std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " task exited normally:" << process.exitCode() << std::endl;
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
			iTaskRetVal = process.exitCode();
			if (iTaskRetVal < 1000)
			{
				// Though the process exit normally,That iTaskRetVal is less than 1000 means not returning from algorithm function,but because of other state,
				process.close();

				// load,if pid loaded from taskPidFile equals taskPid,remove it.

								///taskPid = -1;
				std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
				if (bSpecialLog)
				{

					std::ostringstream oss;
					oss.clear();
					//					oss << __FUNCTION__ << " LINE " << __LINE__ << "  " << "jobfile already in cancelled dir.";
								//		std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " task exit with code(less than 1000):" << process.exitCode() << std::endl;
					oss << " task exit with code(less than 1000):" << process.exitCode();
					LOGI(oss.str());
				}

				ATTaskInfo attask;
				attask.load(qstr2str(NewFileForRun));
				std::string job_file = qstr2str(Settings::getEngineJobQueue()) + "/Running/" + attask.job_ + ".json";

				JobFullInfo_s jobinfo(job_file);
				QString jobFilePathLock = str2qstr(job_file) + ".lock";
				FILE* fp = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);

				if (fp != NULL)
				{
					std::ostringstream strLine;
					strLine.clear();
					strLine << "print time sum now " << __FUNCTION__ << " LINE " << __LINE__;
					PrintTimeSum(strLine.str());
					///					bool bsave = jobinfo.save(job_file);
					ExportTimeSum(jobinfo/*, jobinfo.tg.tasksmap.at(0).Type == 4 ? 1 : 0*/);
					fclose(fp);

					//std::cout << __FILE__ << __LINE__ << "save job's time sum info:" << job_file << "!" << std::endl;
					LOGI("save job's time sum info::" + job_file);
				}


				if (fpTaskLock != NULL)
				{
					fclose(fpTaskLock);
					fpTaskLock = NULL;
					LOGI("release taskfile lock:" + qstr2str(NewFileForRun));
				}
				std::string msg = fileName + " task value is less than 1000.";
				std::cout << msg << std::endl;
				LOGI(msg);
				return -1;
			}


			if (iTaskRetVal == 1099)
			{
				if (exceptionMsg.isEmpty())
				{
					exceptionMsg = "MoldAITask Crashed.";
				}
			}

			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				//					oss << __FUNCTION__ << " LINE " << __LINE__ << "  " << "jobfile already in cancelled dir.";
							//		std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " task exit with code(less than 1000):" << process.exitCode() << std::endl;
				oss << " task exit with code:" << process.exitCode();
				LOGI(oss.str());
			}
		}
		else
		{
			// while reaching here,it should have crashed.
			// just give it up for a moment.
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				//					oss << __FUNCTION__ << " LINE " << __LINE__ << "  " << "jobfile already in cancelled dir.";
				//std::cout << __FILE__ << __FUNCTION__ << " " << __LINE__ << " task crashed:" << std::endl;
				oss << qstr2str(NewFileForRun) << " task crashed:" << process.exitCode();
				LOGI(oss.str());
			}

			process.close();

			if (fpTaskLock != NULL)
			{
				fclose(fpTaskLock);
				fpTaskLock = NULL;
				LOGI("relase taskfile lock:" + qstr2str(NewFileForRun));
			}

			exceptionMsg = "MoldAITask Crashed.";
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
			/// return -1;
			iTaskRetVal = 1099;
		}

		process.close();

		bLoadFeedbackFileError = false;

		bool readrtn = feadback.load_with_retry(feedback_file);
		if (!readrtn)
		{
			bLoadFeedbackFileError = true;
		}

		if (iTaskRetVal == 1000 && type == ATSTARTTYPE && fabs(feadback.Percent - 1.0) <= 0.0001)//空三的
		{
			std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
			if (bSpecialLog)
			{
				std::ostringstream oss;
