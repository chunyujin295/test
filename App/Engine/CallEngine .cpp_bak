					LOGI("job task has already disappeared:" + job_file);
				}
			}

			JobFullInfo_s jobinfo(job_file);


			QString jobFilePathLock = str2qstr(job_file) + ".lock";
			FILE* fp = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);

