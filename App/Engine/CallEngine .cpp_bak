void ProcessUnnormaldRunningJob()
{
	return;
	Sleep(500);

	ATTaskInfo attask;
	if (!attask.load(NewFileForRun.toStdString()))
		return ;
	if (attask.job_ == "")
		return;
	std::string job_file = Settings::getEngineJobQueue().toStdString() + "/Running/" + attask.job_ + ".json";
	std::string feedbakpath = AI3D::CORE::File::GetParentDir(attask.projectFile_) + "/" + attask.blockItem_ + "/";// "feedback_" + attask.job_ + ".json";
	std::string current_feedback_file = MAKE_FEEDBAK_FILE(feedbakpath,attask.job_);// AI3D::CORE::File::GetParentDir(attask.projectFile_) + "/" + attask.blockItem_ + "/" + feedname;
	
	QString jobFileName = QString::fromStdString(job_file);
	QString lsRunningJobFileName = QFileInfo(jobFileName).fileName();
	QString lsPendingJobFile = pendingJobPath + pathSeperator + lsRunningJobFileName;
	QString lsRunningJobFile = runningJobPath + pathSeperator + lsRunningJobFileName;

	QString lsCompletedJobFile = completedJobPath + pathSeperator + lsRunningJobFileName;;
	QString cancelledJobFile = cancelledJobPath + pathSeperator + lsRunningJobFileName;
	QString failedJobFile = failedJobPath + pathSeperator + lsRunningJobFileName;

	QString jobFilePathLock = QString::fromStdString(job_file) + ".lock";
	QString taskLock = NewFileForRun + ".lock";
	std::string feedLock = current_feedback_file + ".lock";
	QFile lockFilejob(jobFilePathLock);
	QFile lockFilefeed(QString::fromStdString(feedLock));
	QFile lockFiletask(taskLock);

	if (!gotNewPendingJobFile /*&& NewFileForRun.isEmpty()*/)//说明有正在跑的任务，没有就不需要处理
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(1000));
		return;
	}

	//if (!lsRunningJobFileName.isEmpty())
	{
		if (!bfs::exists(job_file))
		{
			if (QFileInfo::exists(QString::fromStdString(job_file)))
			{
				SimpleWriteLog(job_file + " (job_file) exists.");
			}
			else
			{
				SimpleWriteLog(job_file + " (job_file) doesn't exists.");
			}

			if (QFileInfo::exists(lsPendingJobFile))
				SimpleWriteLog(lsPendingJobFile + " (lsPendingJobFile) exists.");
			else
				SimpleWriteLog(lsPendingJobFile + " (lsPendingJobFile) doesn't exists.");

			if (QFileInfo::exists(lsRunningJobFile))
				SimpleWriteLog(lsRunningJobFile + " (lsRunningJobFile) exists.");
			else
				SimpleWriteLog(lsRunningJobFile + " (lsRunningJobFile) doesn't exists.");

			if (QFileInfo::exists(lsCompletedJobFile))
				SimpleWriteLog(lsCompletedJobFile + " (lsCompletedJobFile) exists.");
			else
				SimpleWriteLog(lsCompletedJobFile + " (lsCompletedJobFile) doesn't exists.");

			if (QFileInfo::exists(cancelledJobFile))
				SimpleWriteLog(cancelledJobFile + " (cancelledJobFile) exists.");
			else
				SimpleWriteLog(cancelledJobFile + " (cancelledJobFile) doesn't exists.");

			if (QFileInfo::exists(failedJobFile))
				SimpleWriteLog(failedJobFile + " (failedJobFile) exists.");
			else
				SimpleWriteLog(failedJobFile + " (failedJobFile) doesn't exists.");

			if (!gotNewPendingJobFile /*&& NewFileForRun.isEmpty()*/)//说明有正在跑的任务，没有就不需要处理
			{
				std::this_thread::sleep_for(std::chrono::milliseconds(1000));
				return;
			}

			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << __FUNCTION__ << " LINE " << __LINE__ << " to kill 1";
				LOGI(oss.str());
			}

			killTaskProcess();

			//此时读feedback如果feedback为cancle,如过不为则更新
			JobFeedBack_s feadback;

			bool bLoadFeedbackFileError = false;
			if (!feadback.load(current_feedback_file))
			{
				bLoadFeedbackFileError = true;
			}
			else
			{
			}

			///bool LoadFeedbackFile(std::string & feedback_file, JobFeedBack_s & job_feedback, bool retry_more_times)

			if (bLoadFeedbackFileError)
			{
				bLoadFeedbackFileError = LoadFeedbackFile(current_feedback_file, feadback, true);
				if (bLoadFeedbackFileError)
				{
					SimpleWriteLog(QString("loading feedback still failed by gjson after killing 1."));
				}
				else
				{
					SimpleWriteLog(QString("loading feedback still succeeded by gjson after killing 1."));
				}

			}

			if (!bLoadFeedbackFileError && feadback.Status == jobsta_e::STATUS_CANCLE)
			{
				//看一下cancle目录下有没有，如果没有则输出job到cancle目录下如果有则不做任何处理
				if (QFile::exists(cancelledJobFile) || QFileInfo(cancelledJobFile).exists())
				{
					//表示是其他节点处理好了的；
					SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
				}
				else
				{
					std::cout << "cannot find " << qstr2str(lsRunningJobFileName) << std::endl;					
					feadback.Status = jobsta_e::STATUS_UNKNOWN;
					feadback.Percent = 0;
					feadback.save_with_retry(current_feedback_file);
					std::cout << " unknown status." << std::endl;

					SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
				}
			}
			else if (bLoadFeedbackFileError || feadback.Status == jobsta_e::STATUS_RUNNING)//如果不是cancle是running则说明没有处理则赋值为cancle
			{
				feadback.Status = jobsta_e::STATUS_CANCLE;
				feadback.save_with_retry(current_feedback_file);
				SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
			}
			else if (feadback.Status == jobsta_e::STATUS_FAILURE)//如果是失败了，但是job文件又没有说明应该是别的task已经处理完失败的情形了此处只需停止就行
			{
				//看一下failed目录下有没有，如果没有则输出job到cancle目录下如果有则不做任何处理
				if (QFile::exists(failedJobFile) || QFileInfo(failedJobFile).exists())
				{
					//表示是其他节点处理好了的；
					SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
				}
				else//如果falied目录没有则输出
				{
					feadback.Status = jobsta_e::STATUS_FAILURE;
					feadback.Percent = 0;
					feadback.save_with_retry(current_feedback_file);
					std::cout << " unknown status." << std::endl;
					std::cout << "cannot find " << qstr2str(lsRunningJobFileName) << std::endl;
					SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
				}
			}

			SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
			init();
			Sleep(100);


		}
		else //存在则为正常处理
		{
			JobFeedBack_s feadback;
			bool bLoadFeedbackFileError = false;

			if (!feadback.load(current_feedback_file))
			{
				bLoadFeedbackFileError = true;
			}		

			if (bLoadFeedbackFileError)
			{
				bLoadFeedbackFileError = LoadFeedbackFile(current_feedback_file, feadback, true);
				if (bLoadFeedbackFileError)
				{
					SimpleWriteLog(QString("loading feedback still failed by gjson before killing 2."));
				}
				else
				{
					SimpleWriteLog(QString("loading feedback still succeeded by gjson before killing 2."));
				}

			}

			jobsta_e status = feadback.Status;
			if (bLoadFeedbackFileError || feadback.Status == jobsta_e::STATUS_CANCLE || feadback.Status == jobsta_e::STATUS_FAILURE)//此时一般为界面过来的
			{
				
				if (!gotNewPendingJobFile /*&& NewFileForRun.isEmpty()*/)//说明有正在跑的任务，没有就不需要处理
				{

					std::this_thread::sleep_for(std::chrono::milliseconds(1000));
					return;
				}
				if (bSpecialLog)
				{
					std::ostringstream oss;
					oss.clear();
					std::string msg = "";

					if(bLoadFeedbackFileError)
						msg = current_feedback_file + " corrupted.";
					else if (feadback.Status == jobsta_e::STATUS_CANCLE)
						msg = current_feedback_file + " cancle.";
					if (feadback.Status == jobsta_e::STATUS_FAILURE)
						msg = current_feedback_file + " failure.";
					oss << __FUNCTION__ << " LINE " << __LINE__ << " to kill 2 because status " << msg;
					LOGI(oss.str());

				}

				killTaskProcess();
				Sleep(100);

				//如果遇上了则所有都强制加锁，
				JobFullInfo_s jobinfo(job_file);

				{
					//并写job以及移动jobfile


					//需要测试一下除AT之外的建模任务
					int taskid = jobinfo.tg.GetLastRunningTaskId();
					if (taskid == -1)
					{
						taskid = jobinfo.tg.GetFirstPendingTaskId();

					}

					if (taskid == -1)
					{
						SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
						std::cout << "error------ " << std::endl;
						return;
					}
					std::string joboutputfile = cancelledJobFile.toStdString();
					//cancel需要告知是在哪个步骤终止了，失败则是由算法告知所以不用写
					if (bLoadFeedbackFileError || feadback.Status == jobsta_e::STATUS_CANCLE)
					{
						feadback.Msg = jobinfo.tg.tasksmap.at(taskid).Msg + " ";
						feadback.Msg += blk_status_str.at(status);
						feadback.save_with_retry(current_feedback_file);
						std::cout << feadback.Msg << std::endl;
						SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
					}
					else if (feadback.Status == jobsta_e::STATUS_FAILURE)
					{
						std::cout << feadback.Msg << std::endl;
						joboutputfile = failedJobFile.toStdString();
						SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__));
					}
					jobinfo.tg.feedback = feadback;
					QString datatime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss");			
					jobinfo.tg.tasksmap.at(taskid).Status = int(status);					
					jobinfo.tg.runinfo.runninginfo.EndTime = datatime.toStdString();
					
					SimpleWriteLog("saving job file:" + joboutputfile + " after killing 2.");
					bool bsave = jobinfo.save(joboutputfile);

					std::this_thread::sleep_for(std::chrono::milliseconds(1000));
					std::ostringstream strLine;
					strLine.clear();
					strLine << "print time sum now " << __FUNCTION__ << " LINE " << __LINE__;
					
					PrintTimeSum(strLine.str());
					ExportTimeSum(jobinfo/*, jobinfo.tg.tasksmap.at(0).Type == 4 ? 1 : 0*/);
					if (boost::filesystem::exists(jobFileName.toStdString()))
					{
						SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3 %4").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__).arg(jobFileName));

						QFileInfo finfo(str2qstr(joboutputfile));
						if (finfo.exists())
						{
							SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3 %4 exists,remove %5").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__)
								.arg(str2qstr(joboutputfile)).arg(jobFileName));
							QFile(jobFileName).remove();
						}
						else
						{
							SimpleWriteLog(QString("inside ProcessUnnormalRunningJob %1 %2 %3 %4 doesn't exists,cannot remove %5").arg(__FILE__).arg(__FUNCTION__).arg(__LINE__)
								.arg(str2qstr(joboutputfile)).arg(jobFileName));

							//QFile(jobFileName).remove();
						}
					}

					//加类型判断是AT还是TIle，应该不需要加类型判断可以测试一下

					if (boost::filesystem::exists(qstr2str(jobFilePathLock)))
						lockFilejob.remove();
					if (boost::filesystem::exists(feedLock))
						lockFilefeed.remove();
					if (boost::filesystem::exists(qstr2str(taskLock)))
						lockFiletask.remove();

				}
				init();
				
				Sleep(100);

			}

			

		}
	}
}

/*
more detail hints on deleting lockfile for a specified raw file referenced to as 'rawfile' later:
1)in fact,needn't delete lock file.whenever visiting the lock file,the related process can do furthur works only after successfully locking the specified lockfile.
2)it is not accurate to make sure whether the lockfile is held by some process,just only based on whether the same lockfile exists.
3)if we want to delete a lock file,maybe it is impossible to delete the lockfile at the time when it is locked.It is also,however,not safe to remove it when
  the corresponding file is out of lock state.
4)The following points may be the ideal way to remove the lock file safely without encountering any collisions:
  (1)define a filename variable in the form of 'file-locked-remove' via combining the rawfile's filename with lock and remove flags.
  (2)While doing _fsopen with a DENYWR attribute which limit other process to acess the corresponding filename with write mode except current one for the lockfile
	 successfully,it means lock the lockfile well.Then,we can _fsopen the file-locked-remove filename with the same attribute above,
	 if it also succeeds,we can go on the subsequent logic to remove the lockfile later.if failed to _fsopen the file-locked-remove filename,just abandon it now.
  (3)fclose the lockfile to free the relevant lock for a specific file.
  (3)during the lock state for file-locked-remove filename,it is safe to remove the corresponding lockfile now.
  (4)fclose file-locked-remove filename after removing the lockfile successfully.

5)feedback load/save:
   (1)load consistency:field check or field value range check without locking.
   (2)save before locking.

*/

/*
  check the consistency of feedback file while loading:
  (1)load the content of feedback file into memory.
  (2)parse the content of the feedback file,and check whether it has all the necessary key fields.
  (3)check whether all the values of related key fields are normal value or within suitable range. 
  (4)if failed,sleep and load it in about 3 seconds later. try 3 times at most.and try to minimize the time as possible as we can when saving the feedback file.
  (5)make some necessary modify on feedback class to satisfy new api requirements.
  (6)using some retry mechanism instead of rewriting thread,the later one is a bit complex to implement.
  (7)use  QJsonDocument class to check the consistency of the feedback file.
*/

// instead using a retry mechanism
void doFeedbackRewriteThread()
{
	while (true)
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(200));
	}
}

bool bHasNewerVersion = false;
extern bool CheckOTADownloadedPackageInsideIntranet(int& newVer, QString& newVerName, int& oldVer, QString& oldVerName);

void doIntranetVersionCheckThread()
{
	while (true)
	{
		bool state;		
		int oldVer, newVer;
		QString oldVerName, newVerName;

		if (bQuitingApplication)
			break;

		state = CheckOTADownloadedPackageInsideIntranet(newVer, newVerName, oldVer, oldVerName);
		if (state)
		{
///			std::cout << "ota package has new version,please quit current application and update it.(from " << std::to_string(oldVer) << "(" + oldVerName.toStdString()
///				<< ")" << std::to_string(newVer) << "(" << newVerName.toStdString() << ")." << std::endl;
/// 
			std::cout << "======= NEW OTA PACKAGE HAS BEEN COMING FROM " << std::to_string(oldVer) << "(" + qstr2str(oldVerName)
			<< ") TO " << std::to_string(newVer) << "(" << qstr2str(newVerName) << ") ======" << std::endl;

			break;
		}

		std::this_thread::sleep_for(std::chrono::milliseconds(2000));
	}
}

/*
  constructing a badly damaged feedback file( such as added with more large brackets at the end of the file),
  to reproduce the crash issue inside  execution flow.
  it would be better to simulate the corrupted feedback file during random write process while running inside MokEngine.
*/

void searchUnnormaldRunningJobThread()
{
	while(true)
	{
		if (bQuitingApplication)
			break;

		if (!gotNewPendingJobFile /*&& NewFileForRun.isEmpty()*/)//说明有正在跑的任务，没有就不需要处理
		{
			std::this_thread::sleep_for(std::chrono::milliseconds(1000));
			continue;
		}

		if (NewFileForRun.isEmpty())//说明有正在跑的任务，没有就不需要处理
		{
			std::this_thread::sleep_for(std::chrono::milliseconds(1000));
			continue;
		}

		if (bQuitingApplication)
			break;

		if (bNetworkPathAlreadyInvalid)
			break;

		ProcessUnnormaldRunningJobV2();
		///ProcessUnnormaldRunningJob();

		std::this_thread::sleep_for(std::chrono::milliseconds(500));
	}
}

void GetPendingJob()
{
	QStringList jobNameList;
	QStringList jobFullPathList;

	std::vector<std::string> jobliststring = JobMonitor::SortPendingJobFile(qstr2str(pendingJobPath));
	for (auto iter : jobliststring)
	{
		jobFullPathList.append(str2qstr(iter));
	}
		
	for (int i = 0; i < jobFullPathList.size(); i++)
	{
		QFileInfo finfo(jobFullPathList.at(i));
		jobNameList.append(finfo.fileName());
	}

	for (int i = 0; i < jobNameList.size(); i++)
	{
		int jobPos = i;

		QString jobFilePath = jobFullPathList.at(jobPos);
		QString jobFileName = jobNameList.at(jobPos);

		if (bQuitingApplication)
			break;

		if (!QFile(jobFilePath).exists())
			continue;

		std::string jobFileNameString = qstr2str(jobFileName);
		std::string jobBaseNameString = qstr2str(QFileInfo(jobFilePath).baseName());
		std::string jobFilePathString = qstr2str(jobFilePath);

		QString jobFilePathLock = jobFilePath + LOCKFILE_POSTFIX;

		JobFullInfo_s jobpending(jobFilePathString);

		std::string blockpath = jobpending.tg.job.ProjectPath2;
		std::string block = jobpending.tg.job.ItemPath2;

		if (jobpending.JobName != jobBaseNameString)
		{
			continue;
		}
		// 加锁指定job文件.(Pending job)
		FILE* fp = _fsopen(jobFilePathLock.toLocal8Bit().data(), "wt", _SH_DENYWR);
		if (fp != NULL)
		{
			// 加锁成功,表明已经抢到对应的Pending job.当前Engine可以对应Pending Job进行GenTasks处理.
	///		gotNewPendingJobFile = true;//chy add.

			projectfilefullpath = jobpending.tg.job.ProjectPath2;//chy add.

			JobFeedBack_s feadback;
			std::string feedname = FEEDBACK_PREFIX + jobFileNameString;
			std::string feedback_file = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + feedname;
			std::string feedback_filelock = feedback_file + LOCKFILE_POSTFIX;

			// find out the real working state about feedback file based on detail execution behaviour,maybe it is not accurate and not complete just to 
			// check feedback lock file's existence.
			// what is the real relation between feedback file and job file while running?
					
			///if (bfs::exists(feedback_file) && (boost::filesystem::exists(feedback_filelock)))
			///{
			///	QFile(jobFilePathLock).remove();
			///	projectfilefullpath = "";
			///	gotNewPendingJobFile = false;//chy add.

				// release PendingJob lock.
			///	fclose(fp);
			///	continue;
			///}

			// add feedback lock later.switch to next job file while failing to lock feedback file
					
			///if (!bfs::exists(feedback_file))
			{
				// even the feedback file does not exist at the time when detecting its existence a little time ago,
				// it still,however, occasionly happens that other engine node may get and hold the feedback file lock after last detection until the execution of the 
				// following code.
///						feadback.save_with_retry(feedback_file);
			}

			/*feadback.load(feedback_file);*/					
					

			std::string jobdir = qstr2str(ENGINEJOBPATH);

			std::string job_file = jobdir + PATH_SEPARATOR_STR + blk_status_str.at(job_status_e::STATUS_RUNNING) + PATH_SEPARATOR_STR + jobBaseNameString + JSONFILE_POSTFIX;
			QString cancelledJobFile = cancelledJobPath + PATH_SEPARATOR_STR + jobFileName;
			/*feadback = */
			/*feadback.Status = jobsta_e::STATUS_RUNNING;*/

			{

				//正常操作,读取内容并增加running信息

				//避免因通过拷贝文件的方式过来的所以就重新赋值
				JobFullInfo_s jobpending_new;
				//LOGI("aaaa");
				if(jobpending.tg.tasksmap.size() > 0)
				{
					
					jobpending_new.SetPendingInfo(jobpending.tg.tasksmap.at(0).Type,jobBaseNameString, blockpath, block,
						RunInfo_s(jobpending.tg.runinfo.SubmitHostName, jobpending.tg.runinfo.SubmitUser, jobpending.tg.runinfo.SubmitTime));
				}
				else
				{
					
					jobpending_new.SetPendingInfo(1/*jobpending.tg.tasksmap.at(0).Type*/, jobBaseNameString, blockpath, block,
						RunInfo_s(jobpending.tg.runinfo.SubmitHostName, jobpending.tg.runinfo.SubmitUser, jobpending.tg.runinfo.SubmitTime));

				}
				//LOGI("aaaa");
				Run_s runinfo;
				runinfo.RunHostName = getenv("USERNAME");
				runinfo.RunUserName = QHostInfo::localHostName().toStdString();
				QString datatime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss");
				runinfo.StartTime = datatime.toStdString();
				jobpending_new.tg.runinfo.runninginfo = runinfo;
				jobpending_new.tg.feedback.Status = jobsta_e::STATUS_RUNNING;
				/*jobpending_new.tg.feedback = feadback;*/
				feadback = jobpending_new.tg.feedback;
				//LOGI("aaaa");
				if (jobpending.tg.tasksmap.size() > 0)
				{
					jobpending_new.tg.tasksmap.at(0).SetRunningInfo(runinfo);
				}
				//LOGI("aaaa");
				QString toRunningJobFile = runningJobPath + PATH_SEPARATOR_STR + jobFileName;
				std::string basepathstr = AICORE::File::GetParentDir(blockpath);
				basepathstr = AI3D::CORE::File::EnsureTrailingSlash(AI3D::CORE::File::EnsureUnifySlash(std::string(basepathstr)));
				std::string taskpath = AI3D::CORE::File::JoinPaths(basepathstr, block, jobBaseNameString);
				taskpath = AI3D::CORE::File::EnsureTrailingSlash(AI3D::CORE::File::EnsureUnifySlash(std::string(taskpath)));
				std::string taskfile = taskpath + TASK_DEF_ZERO_FILE;//需测试 1121 AICORE::File::GetParentDir(blockpath) + "/" +
					//block + "/" + jobBaseNameString + "/" + TASK_DEF_ZERO_FILE;

				//如果遇到了加锁则放弃该job
				// check it later: it may be not reliable just according to the existence of feedback_filelock.
				//LOGI("aaaa");
				///if (!bfs::exists(taskfile) || bfs::exists(feedback_filelock))
				if (!QFileInfo::exists(str2qstr(taskfile)))
				{
					// In theory,it is impossilbe to reach here.
							
					// The following may be unsafe,whether being placing before freeing related lock or after that.
					// we had better remove all the obsolete job lock in a seperate clean-up  thread.
					///QFile(jobFilePathLock).remove();
					projectfilefullpath = "";
					///gotNewPendingJobFile = false;//chy add.

					fclose(fp);

					Sleep(100);
					continue;
				}
				if (jobpending_new.save(qstr2str(toRunningJobFile)))
				{
					std::ostringstream strLine;
					strLine.clear();
					strLine << "print time sum now " << __FUNCTION__ << " LINE " << __LINE__;
					PrintTimeSum(strLine.str());
					ExportTimeSum(jobpending_new/*, jobpending.tg.tasksmap.at(0).Type==4?1:0*/);

					std::this_thread::sleep_for(std::chrono::milliseconds(1000));

					QFileInfo finfo(toRunningJobFile);
					if (finfo.exists())
					{
						LOGI(qstr2str(QString("save " + jobFilePath + " to " + toRunningJobFile + " ok(remove jobfile.).")));
						QFile(jobFilePath).remove();
					}
					else
					{
						LOGI(qstr2str(QString("save " + jobFilePath + " to " + toRunningJobFile + "ok,but the latter doesn't exist even after waiting for 1 second,try to find out the the cause with great care though deleting the pending job file temporarily(remove jobfile)!!!")));
						QFile(jobFilePath).remove();
					}

					if (!feadback.save_with_retry(feedback_file))
					{
						LOGI("failed to save feedback file inside GetPendingJob!!!");
					}

					if (fpTaskLock != NULL)
					{
						// Though it is impossible,but keeping it for more safety.
						fclose(fpTaskLock);
						fpTaskLock = NULL;
					}

					///  lock this following task file in advance,keep it locked during the entire life  cycle to process it later until finished this task.

					QString taskFilePathLock = str2qstr(taskfile) + ".lock";

					std::string taskfile_lock = taskfile + ".lock";
					fpTaskLock = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);

					if (fpTaskLock == NULL)
					{
						projectfilefullpath = "";
						fclose(fp);
						break;
					}

					//删除pending下的然后

					projectfilefullpath = jobpending_new.tg.job.ProjectPath2;

					// where is the best opportunity to lock this task file?how about its life cycle?
					gotNewPendingJobFile = true; 		

					NewFileForRun = str2qstr(taskfile);

					std::cout << "got pending task:" << taskfile << std::endl;

					fclose(fp);

					///QFile(jobFilePathLock).remove();
							
					break;
				}
				else
				{
					LOGI("failed to move pending job file into running job queue,check it to find out what had happened.");
							
					if (fpTaskLock != NULL)
					{
						fclose(fpTaskLock);
						fpTaskLock = NULL;
					}

					///QFile(jobFilePathLock).remove();
					projectfilefullpath = "";

					///gotNewPendingJobFile = false;//chy add.

					fclose(fp);
					std::this_thread::sleep_for(std::chrono::milliseconds(500));
					continue;
				}

			}

		}
	}

	std::this_thread::sleep_for(std::chrono::milliseconds(500));			
}

int GetRunningTaskInRunningJob()
{
	QStringList jobNameList;
	QStringList jobFullPathList;

	std::vector<std::string> jobliststring = JobMonitor::SortJobFile(qstr2str(runningJobPath));
	for (auto iter : jobliststring)
	{
		jobFullPathList.append(str2qstr(iter));
	}

	if (bSpecialLog)
	{
		std::ostringstream oss;
		oss.clear();
		oss << __FUNCTION__ << " LINE " << __LINE__ << " running jobs lists " << jobliststring.size();
///		std::cout << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
		///LOGI(oss.str());
	}

	for (int i = 0; i < jobFullPathList.size(); i++)
	{
		QFileInfo finfo(jobFullPathList.at(i));
		jobNameList.append(finfo.fileName());
	}

	for (int i = 0; i < jobNameList.size(); i++)
	{
		int jobPos = i;

		if (bQuitingApplication)
			break;

		QString jobFilePath = jobFullPathList.at(jobPos);
		QString jobFileName = jobNameList.at(jobPos);

		if (jobFilePath.endsWith(".lock"))
			continue;

		if (!QFile(jobFilePath).exists())
		{
			std::cout << __FUNCTION__ << " LINE " << __LINE__ << qstr2str(jobFilePath) << std::endl;
			continue;
		}

		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath);
			///LOGI(oss.str());
		}


		std::string jobFileNameString = qstr2str(jobFileName);
		std::string jobBaseNameString = qstr2str(QFileInfo(jobFilePath).baseName());
		std::string jobFilePathString = qstr2str(jobFilePath);

		QString jobFilePathLock = jobFilePath + LOCKFILE_POSTFIX;
		JobFullInfo_s jobinfo(jobFilePathString);

		if (bSpecialLog)
		{
			std::ostringstream oss;
			oss.clear();
			oss << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath) << " taskmaps size " << (std::to_string(jobinfo.tg.tasksmap.size()));
//			std::cout << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
			///LOGI(oss.str());
		}

		if (jobinfo.tg.tasksmap.empty())
		{
			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath) << " taskmaps size empty ";
///				LOGI(oss.str());

			}

			std::cout << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath) << " taskmaps size empty " << std::endl;
			continue;
		}

		if (jobinfo.JobName != jobBaseNameString)
		{
			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath) << " jobinfo.JobName is not equal jobBaseNameString";
				LOGI(oss.str());

			}

			///std::cout << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
			continue;
		}

		std::string blockpath = jobinfo.tg.job.ProjectPath2;
		std::string block = jobinfo.tg.job.ItemPath2;

		/*if (GetJobType(jobinfo.JobName) == JOB_AT)*/
		if (jobinfo.tg.HasTaskDef0())//其实就是AT类型,1121此处应该不分AT类型否
			{
				if (bSpecialLog)
				{
					std::ostringstream oss;
					oss.clear();
					oss << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath) << " has taskdef0 ";
					//std::cout << oss.str() << std::endl;
					LOGI(oss.str());

				}

				//todo什么时候假的锁，有必要加锁吗，job文件project没有了			

				FILE* fpjob = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);

				if (fpjob == NULL)
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << __FUNCTION__ << " LINE " << __LINE__ << " file " << qstr2str(jobFilePathLock) << " locked failed,continue ";
						LOGI(oss.str());
					}

					///std::cout << __FUNCTION__ << " LINE " << __LINE__ << "lock failed." << std::endl;
					continue;
				}

				int id = -1;
	//			std::cout << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
// check:if running,but the engine quit...
				if (jobinfo.tg.tasksmap.at(0).Status != jobsta_e::STATUS_COMPLETE)
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << __FUNCTION__ << " LINE " << __LINE__ << " exists " << qstr2str(jobFilePath) << " taskdef0 is not complete.";
						LOGI(oss.str());
					}


					/// continue;
					id = 0;

					std::string taskfile = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + jobBaseNameString + "/" +
						TASK_DEF_PREFIX + std::to_string(id) + JSONFILE_POSTFIX;

///					QString taskFilePathLock = QString::fromStdString(taskfile) + ".lock";

					std::string taskfile_lock = taskfile + ".lock";
					FILE* fptask = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);
					if (fptask == NULL)
					{
						fclose(fpjob);
						continue;
					}
					else
					{
						fpTaskLock = fptask;
						LOGI("locked succ for : " + taskfile);
					}
				}

				if (id == -1)
				{
					id = jobinfo.tg.GetFirstPendingTaskId();
					if (id >= 0)
					{
						if (bSpecialLog)
						{
							std::ostringstream oss;
							oss.clear();
							oss << " exists " << qstr2str(jobFilePath) << " first pending task id " << std::to_string(id);
							LOGI(oss.str());
						}

						//jobinfo.tg.tasksmap.at(0).
						//此处是为了空三优化的步骤现在不用
				
				
					}

					//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " exists " << jobFilePath.toStdString() << " first pending task id " << (std::to_string(id)) << std::endl;
				}

				int id2 = -1;

				if (id == -1)
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " exists " << qstr2str(jobFilePath) << " first pending task id is not good and continue ";
///						LOGI(oss.str());
					}

					//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " exists " << jobFilePath.toStdString() 
					//	<< " first pending task id is not good continue " << std::endl;

					///  checking running id,but lock has been freed.
				///	continue;
				
					for (auto& iter : jobinfo.tg.tasksmap)
					{
						id2 = iter.first;
						if (iter.second.Status != int(jobsta_e::STATUS_RUNNING))
						{
							id2 = -1;
							continue;
						}

						if (!jobinfo.tg.IsTaskComplete(id2))
						{
							//return id;
							id2 = -1;
							break;
						}

						std::string taskfile = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + jobBaseNameString + "/" +
							TASK_DEF_PREFIX + std::to_string(id2) + JSONFILE_POSTFIX;

///						QString taskFilePathLock = QString::fromStdString(taskfile) + ".lock";

						std::string taskfile_lock = taskfile + ".lock";
						FILE* fptask = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);
						if (fptask == NULL)
						{
							id2 = -1;
							continue;
						}
						else
						{
							fpTaskLock = fptask;
							LOGI("lock task file:" + taskfile);
							break;
						}
					}

					if (id2 == -1)
					{
						fclose(fpjob);
						continue;
					}

					id = id2;

				
				}

				std::string feedname = FEEDBACK_PREFIX + jobBaseNameString + JSONFILE_POSTFIX;
				std::string feedback_file = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + feedname;
				std::string feedback_filelock = feedback_file + LOCKFILE_POSTFIX;

				std::string taskfile = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + jobBaseNameString + "/" +
					TASK_DEF_PREFIX + std::to_string(id) + JSONFILE_POSTFIX;

				if (bSpecialLog)
				{
					std::ostringstream oss;
					oss.clear();
					oss << " jobfile " << qstr2str(jobFilePath) << " taskfile " << taskfile << " id:" << std::to_string(id) << " id2:" << std::to_string(id2);
					LOGI(oss.str());
				}

//				std::cout << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " taskfile " << (taskfile)
//					<< std::endl;

				///if (bfs::exists(feedback_file) && (boost::filesystem::exists(feedback_filelock)))
				///{
				///	if (bSpecialLog)
				///	{
				///		std::ostringstream oss;
				///		oss.clear();
				///		oss << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " feedback_file and feedback_filelock " << (taskfile);
				///		LOGI(oss.str());

				///	}
				///	fclose(fpjob);
				///	QFile(jobFilePathLock).remove();
				///	Sleep(50);
				///	continue;
				///}

				///if (!bfs::exists(taskfile))
				if (!QFileInfo(str2qstr(taskfile)).exists())
				{
					// Normally,it doesn't come here.If occuring occasionally,try to find out what had happened.
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " jobfile " << qstr2str(jobFilePath) << " taskfile is not exist ";
						LOGI(oss.str());
					}

//					std::cout << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() 
//						<< " taskfile is not exist " << std::endl;

					fclose(fpjob);
					///QFile(jobFilePathLock).remove();
					if (fpTaskLock != NULL)
					{
						fclose(fpTaskLock);
						fpTaskLock = NULL;
						LOGI("unlocked lock for task file:" + taskfile);
					}

					Sleep(50);
					continue;
				}

	///			QString taskFilePathLock = QString::fromStdString(taskfile) + ".lock";
				std::string taskfile_lock = taskfile + ".lock";
				///FILE* fptask = NULL;

				if (fpTaskLock == NULL)
				{
					///fptask = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);
					LOGI("preparing to lock taskfile:" + taskfile);
					fpTaskLock = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);
				}

				if (bSpecialLog)
				{
					std::ostringstream oss;
					oss.clear();
					oss << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << qstr2str(jobFilePath) << " taskfile_lock " << (taskfile_lock);
///					LOGI(oss.str());
				}

				if (fpTaskLock == NULL)
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " jobfile " << qstr2str(jobFilePath) << " taskfile lock failed " << taskfile;
						LOGI(oss.str());

					}

					///std::cout << __FUNCTION__ << " LINE " << __LINE__ << " lock task failed." << std::endl;
					fclose(fpjob);
					
					///QFile(jobFilePathLock).remove();

					//projectfilefullpath = "";
					//gotNewPendingJobFile = false;//chy add.

					Sleep(50);
					continue;
				}

				LOGI("locked taskfile succ:" + taskfile);

				JobFeedBack_s feadback;

				bool bLoadFeedbackFileError = false;
				if (!feadback.load_with_retry(feedback_file))
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " jobfile " << qstr2str(jobFilePath) << " load feedback_file failed,feedback status " << feadback.Status;
						LOGI(oss.str());
					}

					bLoadFeedbackFileError = true;

//					std::cout << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " load feedback_file failed,feedback status " 
//						<< feadback.Status << std::endl;

					fclose(fpjob);
					fclose(fpTaskLock);
					fpTaskLock = NULL;

					Sleep(50);
					continue;
				}

				if(feadback.Status != jobsta_e::STATUS_RUNNING)
				{
					// cancelled,failed,completed,and etc.
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " jobfile " << qstr2str(jobFilePath) << " feedback status is not running " << feadback.Status;
						LOGI(oss.str());

					}

					//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " feedback status is not running " 
					//	<< feadback.Status << std::endl;

					///fclose(fptask);

					// It is safe to do cleaning up for all the task file locks in seperate thread.
					// Generally,the following logic is not safe
///					QFile(taskFilePathLock).remove();

///					QFile(jobFilePathLock).remove();
					projectfilefullpath = "";
					// can omit the following line in fact.
					gotNewPendingJobFile = false;//chy add.
					NewFileForRun = "";

					fclose(fpjob);
					fclose(fpTaskLock);
					fpTaskLock = NULL;

					LOGI("unlocked job:" + qstr2str(jobFilePath) + " with taskfile:" +taskfile);

					Sleep(50);
					continue;
				}

///				gotNewPendingJobFile = true;//chy add.

				projectfilefullpath = jobinfo.tg.job.ProjectPath2;//chy add.

				///if (!bfs::exists(feedback_file))
				///{
				///	if (bSpecialLog)
				///	{
				///		std::ostringstream oss;
				///		oss.clear();
				///		oss << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " feedback_file is not exist  " << (feedback_file);
				///		LOGI(oss.str());

				///	}

				///	feadback.Status = jobsta_e::STATUS_RUNNING;
				///	feadback.save(feedback_file);
				///}

				//if (bfs::exists(feedback_file) && (boost::filesystem::exists(feedback_filelock)))
				///{
				///	if (bSpecialLog)
				///	{
				///		std::ostringstream oss;
				///		oss.clear();
				///		oss << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " feedback_file and feedback_filelock ";
				///		LOGI(oss.str());

				///	}
				///	fclose(fptask);
				///	QFile(taskFilePathLock).remove();
				///	fclose(fpjob);
				///	QFile(jobFilePathLock).remove();
				///	projectfilefullpath = "";
				///	gotNewPendingJobFile = false;//chy add.
				///	Sleep(50);
				///	continue;
				///}

				//写信息
				Run_s runinfo;
				runinfo.RunHostName = getenv("USERNAME");
				runinfo.RunUserName = QHostInfo::localHostName().toStdString();
				QString datatime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss");

				runinfo.StartTime = datatime.toStdString();

				jobinfo.tg.tasksmap.at(id).runinfo = runinfo;
				jobinfo.tg.tasksmap.at(id).Status = (int)jobsta_e::STATUS_RUNNING;
				// in fact,the following line is not needed,for the feedback status had been already assigned 'STATUS_RUNNING' inside GetPendingJob at the first early stage.
				feadback.Status = jobsta_e::STATUS_RUNNING;
				jobinfo.tg.feedback = feadback;

				///jobinfo.tg.tasksmap.at(id).

				///if (bfs::exists(feedback_file) && (boost::filesystem::exists(feedback_filelock)))
				///{
				///	if (bSpecialLog)
				///	{
				///		std::ostringstream oss;
				///		oss.clear();
				///		oss << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " feedback_file and feedback_filelock ";
				///		LOGI(oss.str());
				///	}
				///	fclose(fptask);
				///	QFile(taskFilePathLock).remove();
				///	fclose(fpjob);
				///	QFile(jobFilePathLock).remove();
				///	projectfilefullpath = "";
				///	gotNewPendingJobFile = false;//chy add.
				///	Sleep(50);
				///	continue;
				///}

				if (bSpecialLog)
				{
					std::ostringstream oss;
					oss.clear();
					oss << "save jobfile: " << qstr2str(jobFilePath);
					LOGI(oss.str());
				}

				// write lock needed.
				if (jobinfo.save(jobFilePathString))
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " jobfile " << qstr2str(jobFilePath) << " to save jobfile success ,export timesum " << (jobFilePathString);
						LOGI(oss.str());

					}
					std::ostringstream strLine;
					strLine.clear();
					strLine << "print time sum now " << __FUNCTION__ << " LINE " << __LINE__;
					PrintTimeSum(strLine.str());
					ExportTimeSum(jobinfo/*,jobinfo.tg.tasksmap.at(0).Type == 4 ? 1 : 0*/);
						
					///bool savestatus = feadback.save_with_retry(feedback_file);
					///if (bSpecialLog)
					///{
					///	std::ostringstream oss;
					///	oss.clear();
					///	oss << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " to save feedback  " << (feedback_file) << " save status " << savestatus;
					///	LOGI(oss.str());
					///}
					projectfilefullpath = jobinfo.tg.job.ProjectPath2;

					QString  sTmpNewFileForRun = str2qstr(taskfile);

					if (!continueCurrentTask(sTmpNewFileForRun))
					{
						//std::cout << "never to continue with the task, and unlock it:" << sTmpNewFileForRun.toStdString() << std::endl;
						LOGI("never to continue with the task, and unlock it:" + qstr2str(sTmpNewFileForRun));
						fclose(fpTaskLock);
						fpTaskLock = NULL;

						projectfilefullpath = "";
						gotNewPendingJobFile = false;
						NewFileForRun = "";

						fclose(fpjob);
						std::this_thread::sleep_for(std::chrono::milliseconds(500));
						continue;
					}
					else
					{
						//std::cout << "to continue with task:" << sTmpNewFileForRun.toStdString() << std::endl;
						LOGI("to continue with task:" + qstr2str(sTmpNewFileForRun));
					}


					gotNewPendingJobFile = true;
					NewFileForRun = str2qstr(taskfile);

					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << "getrunningtaskinrunningjob succ:jobfile " << qstr2str(jobFilePath) << " gotNewPendingJobFile " << gotNewPendingJobFile << " NewFileForRun " << qstr2str(NewFileForRun);
						LOGI(oss.str());
					}

					//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() <<
					//	" gotNewPendingJobFile " << gotNewPendingJobFile << " NewFileForRun " << NewFileForRun.toStdString() << std::endl;


					///std::this_thread::sleep_for(std::chrono::milliseconds(500));

				///	fclose(fptask);

///					QFile(taskFilePathLock).remove();
					fclose(fpjob);
///					QFile(jobFilePathLock).remove();
					Sleep(50);
					return AI3D_SUCCESS;
				}
				else
				{
					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << " to save jobfile failed with unlocking related lock:" << qstr2str(jobFilePath) << " " << taskfile;
						LOGI(oss.str());

					}

					//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " jobfile " << jobFilePath.toStdString() << " to save jobfile failed  " << (jobFilePathString) << std::endl;

					fclose(fpTaskLock);
					fpTaskLock = NULL;
					///fclose(fptask);
///					QFile(taskFilePathLock).remove();
					
///					QFile(jobFilePathLock).remove();
					projectfilefullpath = "";
					gotNewPendingJobFile = false;//chy add.
					NewFileForRun = "";

					fclose(fpjob);
					std::this_thread::sleep_for(std::chrono::milliseconds(500));
					continue;
				}
			}
		else /*if (GetJobType(jobinfo.JobName) == JOB_BATCH)*/
		{
			if (jobinfo.tg.tasksmap.at(0).Status != jobsta_e::STATUS_COMPLETE)//其余类型只有一个task所以不做处理
			{
				if (bSpecialLog)
				{
					std::ostringstream oss;
					oss.clear();
					oss << __FUNCTION__ << " LINE " << __LINE__ << " exists/prod " << qstr2str(jobFilePath) << " taskdef0 is not complete.status"
						<< jobinfo.tg.tasksmap.at(0).Status;
					LOGI(oss.str());
					std::cout << oss.str() << std::endl;
				}

				std::string feedname = FEEDBACK_PREFIX + jobBaseNameString + JSONFILE_POSTFIX;
				std::string feedback_file = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + feedname;

				if (jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_CANCLE
					|| jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_FAILURE)
				{
					if (jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_CANCLE)
					{
						LOGI("task running/prod cancelled for : " + jobFilePath.toStdString());
						std::cout << ("task running/prod called for : " + jobFilePath.toStdString()) << std::endl;
					}
					else if (jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_FAILURE)
					{
						LOGI("task running/prod failed for : " + jobFilePath.toStdString());
						std::cout << ("task running/prod failed for : " + jobFilePath.toStdString()) << std::endl;
					}
					 
					continue;
				}

				if (jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_PENDDING)
				{
					LOGI("task running/prod pending for : " + jobFilePath.toStdString());
					std::cout << ("task running/prod pending for : " + jobFilePath.toStdString()) << std::endl;

				}
				else if (jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_RUNNING)
				{
					LOGI("task running/prod running for : " + jobFilePath.toStdString());
					std::cout << ("task running/prod running for : " + jobFilePath.toStdString()) << std::endl;
				}
				else
				{
					LOGI("task running/prod unknown for : " + jobFilePath.toStdString());
					std::cout << ("task running/prod unknown for : " + jobFilePath.toStdString()) << std::endl;
				}


				{
					FILE* fpjob = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);
					if (fpjob == NULL)
					{
						LOGI("locked failed/prod for : " + jobFilePath.toStdString());
						std::cout << ("locked failed/prod for : " + jobFilePath.toStdString()) << std::endl;

						continue;
					}

					int id = 0;

					std::string taskfile = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + jobBaseNameString + "/" +
						TASK_DEF_PREFIX + std::to_string(id) + JSONFILE_POSTFIX;

					std::string taskfile_lock = taskfile + ".lock";
					FILE* fptask = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);
					if (fptask == NULL)
					{
						fclose(fpjob);
						continue;
					}

					fpTaskLock = fptask;
					LOGI("locked succ/prod for : " + taskfile);
					std::cout << ("locked succ/prod for : " + taskfile) << std::endl;

					QString NewFileForRunTemp = str2qstr(taskfile);
					// check pid related.
					fclose(fpjob);

					if (!checkTaskInstanceStatus(NewFileForRunTemp))
					{
						fclose(fpTaskLock);
						fpTaskLock = nullptr;

						LOGI("task is unavailable/prod : " + NewFileForRunTemp.toStdString());
						std::cout << ("task is unavailable/prod : " + NewFileForRunTemp.toStdString()) << std::endl;

						std::this_thread::sleep_for(std::chrono::milliseconds(150));
						continue;
					}

					gotNewPendingJobFile = true;
					///NewFileForRun = str2qstr(jobFilePath.toStdString());
					NewFileForRun = str2qstr(taskfile);
					projectfilefullpath = jobinfo.tg.job.ProjectPath2;

					if (bSpecialLog)
					{
						std::ostringstream oss;
						oss.clear();
						oss << "get succ:jobfile/prod " << taskfile << " gotNewPendingJobFile " << gotNewPendingJobFile << " NewFileForRun " << qstr2str(NewFileForRun);
						LOGI(oss.str());
						std::cout << oss.str() << std::endl;
					}

					fclose(fpTaskLock);
					fpTaskLock = nullptr;
					std::this_thread::sleep_for(std::chrono::milliseconds(150));
					return AI3D_SUCCESS;
				}

				LOGI("task completed/prod for : " + jobFilePath.toStdString());
				std::cout << ("task completed/prod for : " + jobFilePath.toStdString()) << std::endl;

				int id = -1;
				if (jobinfo.tg.tasksmap.at(0).Status == jobsta_e::STATUS_RUNNING)
				{
					std::cout << "continue"<<__FUNCTION__ << " LINE " << __LINE__  << std::endl;
					continue;
					if (1)
					{
						FILE* fpjob = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);
						if (fpjob == NULL)
						{
							if (bSpecialLog)
							{
								std::ostringstream oss;
								oss.clear();
								oss << __FUNCTION__ << " LINE " << __LINE__ << " file " << qstr2str(jobFilePathLock) << " locked failed,continue ";
								LOGI(oss.str());
								std::cout << oss.str() << std::endl;
							}
							continue;
						}

						id = 0;
						std::string taskfile = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + jobBaseNameString + "/" +
							TASK_DEF_PREFIX + std::to_string(id) + JSONFILE_POSTFIX;

						std::string taskfile_lock = taskfile + ".lock";
						FILE* fptask = _fsopen(taskfile_lock.c_str(), "wt", _SH_DENYWR);
						if (fptask == NULL)
						{
							fclose(fpjob);
							continue;
						}
						else
						{
							fpTaskLock = fptask;
							LOGI("locked succ for : " + taskfile);
							std::cout << ("locked succ for : " + taskfile) << std::endl;
						}

						projectfilefullpath = jobinfo.tg.job.ProjectPath2;
						QString  sTmpNewFileForRun = str2qstr(taskfile);

						if (!continueCurrentTask(sTmpNewFileForRun))
						{
							LOGI("never to continue with the task, and unlock it:" + qstr2str(sTmpNewFileForRun));
							std::cout << ("never to continue with the task, and unlock it:" + qstr2str(sTmpNewFileForRun)) << std::endl;;
							fclose(fpTaskLock);
							fpTaskLock = NULL;
							projectfilefullpath = "";
							gotNewPendingJobFile = false;
							NewFileForRun = "";
							fclose(fpjob);
							std::this_thread::sleep_for(std::chrono::milliseconds(500));
							continue;
						}
						else
						{
							LOGI("to continue with task:" + qstr2str(sTmpNewFileForRun));
							std::cout << ("to continue with task:" + qstr2str(sTmpNewFileForRun)) << std::endl;
						}

						gotNewPendingJobFile = true;
						NewFileForRun = str2qstr(taskfile);

						if (bSpecialLog)
						{
							std::ostringstream oss;
							oss.clear();
							oss << "getrunningtaskinrunningjob succ:jobfile " << qstr2str(jobFilePath) << " gotNewPendingJobFile " << gotNewPendingJobFile << " NewFileForRun " << qstr2str(NewFileForRun);
							LOGI(oss.str());
							std::cout << oss.str() << std::endl;
						}

						fclose(fpjob);
						Sleep(50);
						return AI3D_SUCCESS;
					}
				}

				std::cout << "not runing" << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
				continue;
			}

			///std::cout << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
		}
	}

	///std::cout << __FUNCTION__ << " LINE " << __LINE__ << std::endl;
	return AI3D_FAILURE;
}

//搜索和执行放在一个线程里
void searchPendingJobThread2()
{
	while (true)
	{
		if (bQuitingApplication)
			break;

		if (bNetworkPathAlreadyInvalid)
			break;

		QStringList checkPathList;
		QStringList errPathList;

		//checkPathList.append(ENGINEJOBPATH + "abcd4");
		checkPathList.append(ENGINEJOBPATH);

		/// call the following function to check whether the network paths above is available now.
		/// check the availability of both the job queue directory and project path,
		/// and give up subsequent behaviours and return immediately if at least one of them is not available now.
		if (!CheckNetworkState(checkPathList, errPathList))
		{
			// popup msgbox,print information to stdout,and return immediately.
///			std::cout << "the following network paths is not available3:" << errPathList.join(" ").toStdString() << std::endl;
			bNetworkPathAlreadyInvalid = true;

	//		QString errStr = "network paths is not available4:" + errPathList.join(" ");
			QString errStr = errPathList.join("\n");
			LOGI(qstr2str(errStr));
	
			msgBoxThread->showInformation(errStr);

//			std::cout << "the following network paths is not available5:" << errPathList.join(" ").toStdString() << std::endl;

///			return -1;
			break;
		}

		if (gotNewPendingJobFile || !NewFileForRun.isEmpty())
		{
			std::this_thread::sleep_for(std::chrono::milliseconds(1000));
			/*if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << __FUNCTION__ << " LINE " << __LINE__ << " gotjob " << gotNewPendingJobFile;
				LOGI(oss.str());
				
			}*/
		
			continue;
		}

		if(taskrunning)
		{
			/*if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << __FUNCTION__ << " LINE " << __LINE__ << " taskrunning " << taskrunning;
				LOGI(oss.str());				
			}*/

			std::this_thread::sleep_for(std::chrono::milliseconds(1000));
			continue;
		}

		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;

		//先找running的
	/*	std::ostringstream oss;
		oss.clear();
		oss << __FUNCTION__ << " LINE " << __LINE__ << "ready to get job";
		LOGI(oss.str());*/
		
		if (fpTaskLock != NULL)
		{
			fclose(fpTaskLock);
			fpTaskLock = NULL;
			
			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << " no taskfile should have been locking here,why?" << qstr2str(NewFileForRun);
				LOGI(oss.str());
			}
		}

		//LOGI("bbb");
		if (GetRunningTaskInRunningJob() != AI3D_SUCCESS)
		{
	//		std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << "no running job ,to get pending job";
				///std::cout << oss.str() << std::endl;
				//LOGI(oss.str());				
			}
	//		std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
	//		LOGI("before GetPendingJob.");
			//LOGI("bbb");
			GetPendingJob();
			//LOGI("bbb");
	//		std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
	//		LOGI("after GetPendingJob.");
		}
#if 1
		//说明找到了
		//LOGI("bbb");
		if (bSpecialLog)
		{
			//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
			//std::ostringstream oss;
			//oss.clear();
			//oss << " job got " << gotNewPendingJobFile << " " << NewFileForRun.toStdString();
			//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " job got " << gotNewPendingJobFile << " " << NewFileForRun.toStdString();
			//LOGI(oss.str());
			
		}

		if (gotNewPendingJobFile && !NewFileForRun.isEmpty())
		{		
//			std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;

			//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << "gotNewPendingJobFile:" << gotNewPendingJobFile << " NewFileForRun:"
			//	<< NewFileForRun.toStdString() << std::endl;

			if (fpTaskLock != NULL)
			{
				LOGI("before execing task file:" + qstr2str(NewFileForRun));
				std::cout << ("before execing task file:" + qstr2str(NewFileForRun)) << std::endl;
			}
			else
			{
				LOGI("before execing task file2:" + qstr2str(NewFileForRun));
				std::cout << ("before execing task file2:" + qstr2str(NewFileForRun)) << std::endl;
			}

			taskPid = qApp->applicationPid();
			taskPidFile = NewFileForRun + ".pid";


			///if (ExecTaskFile() == -1)
			if(ExecTaskFileV2() == -1)
			{
			//	std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
				LOGI("execing task file failed:" + qstr2str(NewFileForRun));
				std::cout << ("execing task file failed:" + qstr2str(NewFileForRun)) << std::endl;
				init();
			}

			if(fpTaskLock != NULL)
				LOGI("after execing task file:gotNewPendingJobFile:" + qstr2str(NewFileForRun));
			else
				LOGI("after execing task file:gotNewPendingJobFile2:" + qstr2str(NewFileForRun));

			taskPid = -1;
			NewFileForRun = "";
//			std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;

			//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << "gotNewPendingJobFile:" << gotNewPendingJobFile << " NewFileForRun:"
			//	<< NewFileForRun.toStdString() << std::endl;
		}
#endif
		if(!bNetworkPathAlreadyInvalid)
			std::this_thread::sleep_for(std::chrono::milliseconds(1000));
	}

}


int RunAlgorithmCommonDummy2(const std::string function_name, const std::string& task_json_file, int taskIndex)
{
	QString path = QCoreApplication::applicationDirPath();
	QString workingDirectory = path;

	if (boost::filesystem::exists(task_json_file + ".lock"))
	{
		return -1;
	}

	if (!gotNewPendingJobFile && NewFileForRun.isEmpty())//
	{

		std::this_thread::sleep_for(std::chrono::milliseconds(1000));
		init();
		return -1;
	}
	if (function_name=="")
	{
		return -1;
	}
	if(taskrunning)
	{
		return -1;
	}
	// 如果Motask.exe运行中,先关闭运行中的Motask.exe.
	if (bSpecialLog)
	{
		std::ostringstream oss;
		oss.clear();
		oss << __FUNCTION__ << " LINE " << __LINE__ << " to kill 3 ";
		LOGI(oss.str());
		
	}
	killTaskProcess();
	QString timenow = (QDateTime::currentDateTime()).toString("yyyy-MM-dd hh:mm:ss.zzz");
	std::cout << "[" << timenow.toStdString() << "] Engine: Run Task " << std::endl;
	// 启动Motask.exe进程,执行传入的task json任务.
	path.append("/MoldAITask.exe");

	QStringList argumentList;
	argumentList << str2qstr(const_cast<std::string &>(task_json_file));

	qint64 pid = -1;

	QProcess process;
	//chy 为啥是startdetached,不是start,非阻塞，后续可以边执行边更新日志
	//motask写log，engine同步读
	process.startDetached(path, argumentList, workingDirectory, &pid);
	if (bSpecialLog)
	{
		std::ostringstream oss;
		oss.clear();
		oss << __FUNCTION__ << " LINE " << __LINE__;
		LOGI(oss.str());
		
	}
	int state = 0;
	// 等待Motasak.exe进程启动成功
	process.waitForStarted();
	taskrunning = true;
	if (bSpecialLog)
	{
		std::ostringstream oss;
		oss.clear();
		oss << __FUNCTION__ << " LINE " << __LINE__;
		LOGI(oss.str());
		
	}
	//if (function_name == StepAT_function.at(GenTasks))
	//{
	//	std::cout << "1" << std::endl;
	//	taskrunning = true;
	//	process.waitForFinished();
	//	Sleep(100);
	//}
	//else
	{
		while (catchProcess.IsProgramRunning("MoldAITask.exe"))
		{
			if (bSpecialLog)
			{
				std::ostringstream oss;
				oss.clear();
				oss << __FUNCTION__ << " LINE " << __LINE__;
				LOGI(oss.str());
				
			}
			state++;
			Sleep(100);
		}
	}
	

	return state;
}

int ExecTaskFileV2()
{
	QString path = APPPATH;
	QString workingDirectory = path;

	std::string fileName = qstr2str(NewFileForRun);

	ATTaskInfo atparam;;
	///std::cout << "load task file:" << fileName;
	std::string msg = "load task file:" + fileName;
	std::cout << msg << std::endl;
	LOGI(msg);
	atparam.load(fileName);
	std::string function = atparam.task_.fun_name_;

	QString exceptionMsg;

	std::string blockpath1 = atparam.projectFile_;
	std::string blockpath = atparam.projectFile2_;

	QString qsBlockPath1 = str2qstr(blockpath1);
	QString qsBlockPath = str2qstr(blockpath);

	

	std::string block = atparam.blockItem2_;
	std::string jobname = atparam.job2_;


	JobFeedBack_s feadback;
	std::string feedname = FEEDBACK_PREFIX + jobname + JSONFILE_POSTFIX;
	std::string  feedback_file = AICORE::File::GetParentDir(blockpath) + "/" + block + "/" + feedname;
	std::string feedback_filelock = feedback_file + LOCKFILE_POSTFIX;
	bool bLoadFeedbackFileError = false;

	std::string projectPath = AICORE::File::GetParentDir(blockpath);

	

	if (bNetworkPathAlreadyInvalid)
	{
		std::string msg = "bNetworkPathAlreadyInvalid:" + fileName;
		std::cout << msg << std::endl;
		LOGI(msg);
		return -1;
	}

	

	QStringList checkPathList;
	QStringList errPathList;

	
	checkPathList.append(str2qstr(projectPath));

	checkPathList.append(ENGINEJOBPATH);

	// getATBlockJobPath 

	//std::cout << projectPath << " ---- " << qstr2str(ENGINEJOBPATH) << std::endl;

/// call the following function to check whether the network paths above is available now.
/// check the availability of both the job queue directory and project path,
/// and give up subsequent behaviours and return immediately if some of them are not available now.

	if (!CheckNetworkState(checkPathList, errPathList))
	{
///		QString errStr = "network paths is not available:" + errPathList.join(" ");
		QString errStr = errPathList.join("\n");
		// popup msgbox,print information to stdout,and return immediately.
///		std::cout << "the following network paths is not available:" << errPathList.join(" ").toStdString() << std::endl;
		bNetworkPathAlreadyInvalid = true;

		LOGI(qstr2str(errStr));
		std::cout << "netstat:" << qstr2str(errStr) << std::endl;
		msgBoxThread->showInformation(errStr);

///		std::cout << "the following network paths is not available2:" << errPathList.join(" ").toStdString() << std::endl;
		std::string msg = "CheckNetworkState:" + fileName;
		std::cout << msg << std::endl;
		LOGI(msg);
		return -1;
	}


	int type = atparam.task_.type_;
	int taskid = atparam.task_.id_;
	if(type!=4)
	{
			std::vector<std::string> taskList;
			std::string dirPath = qstr2str(getATBlockJobPath(str2qstr(fileName)));

			std::string dirnew = getATBlockJobPath(fileName);
			getTaskList(dirPath, taskList);

			toBeCleanedJobMap.insert(str2qstr(jobname), str2qstr(dirnew));
			hasFinishedJobMap.insert(str2qstr(jobname), 0); // pending

			int task_count = taskList.size();

			maptaskfunction[0] = StepAT_function.at(GenTasks);

			for (auto taskfile : taskList)
			{
				ATTaskInfo task;
				task.load(taskfile);

				//Task_s newtask;
				//newtask.Id = task.task_.id_;
				maptaskfunction[task.task_.id_] = task.task_.fun_name_;
			}
	}

	//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
	///if (!boost::filesystem::exists(feedback_file))
	if (!feadback.load_with_retry(feedback_file))
	{
		bLoadFeedbackFileError = true;
		LOGI("loading feedback file failed:" + feedback_file);
		return -1;
	}

	if (feadback.Status == jobsta_e::STATUS_PENDDING)
	{
		// Theoretically,it cannot be in pending status,for having already been changed into running status at the time while getting the pending job successfully 
		// before coming here.
		feadback.Percent = 0.0;
		feadback.Status = jobsta_e::STATUS_RUNNING;
		feadback.save_with_retry(feedback_file);

		//hasFinishedJobMap.insert(str2qstr(jobname),1);
	}

	///feadback.load(feedback_file);

	if (feadback.Status != jobsta_e::STATUS_RUNNING)
	{
		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
		// it isn't necessary to go on with current task,for the job have already come to one of the end statuses such as completed,cancelled,failed and etc.
		LOGI("current job file is not running now:" + qstr2str(NewFileForRun));
		if (fpTaskLock != NULL)
		{
			fclose(fpTaskLock);
			fpTaskLock = NULL;
			LOGI("current job file is not running now:" + qstr2str(NewFileForRun) + " ,unlock taskfile lock.");
		}

		std::string msg = fileName + "is not running."  ;
		std::cout << msg << std::endl;
		LOGI(msg);
		return -1;
	}

	

	if (!gotNewPendingJobFile && NewFileForRun.isEmpty())
	{
		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << NewFileForRun.toStdString() << std::endl;
		if (fpTaskLock != NULL)
		{
			fclose(fpTaskLock);
			fpTaskLock = NULL;
		}

		LOGI("current job file is not in normal state:" + qstr2str(NewFileForRun));
		return -1;
	}
	//代表空三状态
	if (type == ATLASTTASKTYPE)
	{
					
				
					
					int resultCode = AI3D_SUCCESS;
					//如果为0类型 就看其子和父任务是否有完成如果完成了则写job  和feedback，没有完成则返回


					std::string jobdirstr = qstr2str(runningJobPath) + "/" + jobname + ".json";


					JobFullInfo_s jobinfo(jobdirstr);
					if (jobinfo.tg.IsTaskComplete(taskid))
					{

						QString jobFilePathLock = str2qstr(jobdirstr) + ".lock";
						std::string jobdirstr = qstr2str(runningJobPath) + "/" + jobname + ".json";
						JobFullInfo_s jobinfo(jobdirstr);
						jobFilePathLock = str2qstr(jobdirstr) + ".lock";
						// 加锁指定job文件.(Pending job)

						// todo:need to consider the complete status for the last task?
						FILE* fp = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);

						if (fp != NULL)
						{


							//别的则需要加
							feadback.Status = job_status_e::STATUS_COMPLETE;
							feadback.Percent = COMPLETE_PROGRESS;
							QString datatime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss");

							jobinfo.tg.tasksmap.at(taskid).runinfo.EndTime = datatime.toStdString();
							jobinfo.tg.tasksmap.at(taskid).Status = int(job_status_e::STATUS_COMPLETE);
							jobinfo.tg.tasksmap.at(taskid).Percent = float(COMPLETE_PROGRESS);
							feadback.Msg = GetTaskEndingString(jobinfo.JobName);

							hasFinishedJobMap.insert(str2qstr(jobinfo.JobName), 2);

							jobinfo.tg.feedback = feadback;

							jobinfo.tg.runinfo.runninginfo.EndTime = datatime.toStdString();

							QString jobFileName = str2qstr(jobdirstr);
							QString lsRunningJobFileName = QFileInfo(jobFileName).fileName();
							QString lsCompletedJobFile = completedJobPath + pathSeperator + lsRunningJobFileName;;
							bool bsave = jobinfo.save(qstr2str(lsCompletedJobFile));

							if (!bsave)
							{
								if (bSpecialLog)
								{
									std::ostringstream oss;
									oss.clear();
									oss << __FUNCTION__ << " LINE " << __LINE__ << "  " << "failed to save jobfile into completed dir.";
									LOGI(oss.str());
								}
							}
							std::ostringstream strLine;
							strLine.clear();
							strLine << "print time sum now " << __FUNCTION__ << " LINE " << __LINE__;
							PrintTimeSum(strLine.str());
							ExportTimeSum(jobinfo/*, jobinfo.tg.tasksmap.at(0).Type == 4 ? 1 : 0*/);

							std::this_thread::sleep_for(std::chrono::milliseconds(500));

							if (bSpecialLog)
							{
								LOGI("remove " + qstr2str(jobFileName) + " for completion status.");
							}

							// may check the existence of the completed job file before removing current running job file.
							QFile(jobFileName).remove();

							///	std::this_thread::sleep_for(std::chrono::milliseconds(500));

							if (!feadback.save_with_retry(feedback_file))
							{
								if (bSpecialLog)
								{
									std::ostringstream oss;
									oss.clear();
									oss << __FUNCTION__ << " LINE " << __LINE__ << "  " << "failed to save feedback with complete status.";
									LOGI(oss.str());
								}
							}

							LOGI("after remove jobfile:" + qstr2str(jobFileName) + " taskfile:" + qstr2str(NewFileForRun));

							init();
							fclose(fp);
							///						QFile(jobFilePathLock).remove();


							return resultCode;
						}
						else
						{
							// what to do if lock failed?
							// retry or process in other thread?
						}
					}
					else
					{
						std::cout << "---===--" << std::endl;
						LOGI("jobfile:" + jobdirstr + " taskfile:" + qstr2str(NewFileForRun));
						init();
						Sleep(30);
						return -1;
					}
	}
	else if (type == ATCOMPLETETYPE)
	{
		{
			int resultCode = AI3D_SUCCESS;
			//如果为0类型 就看其子和父任务是否有完成如果完成了则写job  和feedback，没有完成则返回


			std::string jobdirstr = qstr2str(runningJobPath) + "/" + jobname + ".json";


			JobFullInfo_s jobinfo(jobdirstr);
			if (jobinfo.tg.IsTaskComplete(taskid))
			{

				QString jobFilePathLock = str2qstr(jobdirstr) + ".lock";
				std::string jobdirstr = qstr2str(runningJobPath) + "/" + jobname + ".json";
				JobFullInfo_s jobinfo(jobdirstr);
				jobFilePathLock = str2qstr(jobdirstr) + ".lock";
				// 加锁指定job文件.(Pending job)

				// todo:need to consider the complete status for the last task?
				FILE* fp = _fsopen(qstr2str(jobFilePathLock).c_str(), "wt", _SH_DENYWR);

				if (fp != NULL)
				{
					//陈海燕 20240826 add
