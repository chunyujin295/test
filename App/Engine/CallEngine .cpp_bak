bool continueCurrentTask(QString &sTmpNewFileForRun)
{
	if (bQuitingApplication)
		return false;

	if (sTmpNewFileForRun.isEmpty() /* || !gotNewPendingJobFile*/)
		return false;

	if (!QFileInfo::exists(sTmpNewFileForRun))
		return false;

	QString sTaskPidFile = sTmpNewFileForRun + ".pid";
	if (!QFileInfo::exists(sTaskPidFile))
		return true;

	bool bSuccessfullyLoadedFromTaskTimeFile = false;

	TaskTimeInfo _taskTimeInfo;

	// qjson gbk? utf8?
	QFile fileTaskTimeInfo(sTaskPidFile);
	if (fileTaskTimeInfo.open(QIODevice::ReadOnly))
	{
		QByteArray baTaskTimeInfo = fileTaskTimeInfo.readAll();
		QJsonParseError errorTaskTimeInfo;

		QJsonDocument jsonDoc = QJsonDocument::fromJson(baTaskTimeInfo, &errorTaskTimeInfo);
		if (errorTaskTimeInfo.error == QJsonParseError::NoError && !jsonDoc.isNull())
		{
			//_taskTimeInfo = jsonDoc.
			QJsonObject jsonObj = jsonDoc.object();
			if (jsonObj.contains("taskPid") && jsonObj.contains("taskFile") && jsonObj.contains("lastActiveTime"))
			{
				_taskTimeInfo.iTaskPid = jsonObj.value("taskPid").toInt();
				_taskTimeInfo.sTaskFile = jsonObj.value("taskFile").toString();

				_taskTimeInfo.sLastActiveTime = jsonObj.value("lastActiveTime").toString();

				bSuccessfullyLoadedFromTaskTimeFile = true;
			}
		}

		fileTaskTimeInfo.close();

		if (bSuccessfullyLoadedFromTaskTimeFile)
		{
			// calculate the time difference which is from the last active time to now?
			QDateTime dtLastActiveTime = QDateTime::fromString(_taskTimeInfo.sLastActiveTime, "yyyyMMddhhmmss");
			QDateTime dtNow = QDateTime::currentDateTime();

			int diffSecs = dtLastActiveTime.secsTo(dtNow);
			if (diffSecs > 5) // over 5 secs.
				return true;
			else
				return false;
		}
		else
		{
			return true;
		}
	}
	else
		return true;
}

void execTaskTimeThread()
{
	while (true)
	{
		bool bSuccessfullyLoadedFromTaskTimeFile = false;
		TaskTimeInfo taskTimeInfo;

		if (bQuitingApplication)
			break;

		if (taskPid == -1 || taskPidFile.isEmpty() || NewFileForRun.isEmpty() || !gotNewPendingJobFile)
		{
			std::this_thread::sleep_for(std::chrono::milliseconds(100));
			continue;
		}

		if (!QFileInfo::exists(NewFileForRun))
		{
			std::this_thread::sleep_for(std::chrono::milliseconds(100));
			continue;
		}

		if (QFileInfo::exists(taskPidFile))
		{
			TaskTimeInfo _taskTimeInfo;

			QFile fileTaskTimeInfo(taskPidFile);
			if (fileTaskTimeInfo.open(QIODevice::ReadOnly))
			{
				QByteArray baTaskTimeInfo = fileTaskTimeInfo.readAll();
				QJsonParseError errorTaskTimeInfo;

				QJsonDocument jsonDoc = QJsonDocument::fromJson(baTaskTimeInfo,&errorTaskTimeInfo);
				if (errorTaskTimeInfo.error == QJsonParseError::NoError && !jsonDoc.isNull())
				{
					//_taskTimeInfo = jsonDoc.
					QJsonObject jsonObj = jsonDoc.object();
					if (jsonObj.contains("taskPid") && jsonObj.contains("taskFile") && jsonObj.contains("lastActiveTime"))
					{
						_taskTimeInfo.iTaskPid = jsonObj.value("taskPid").toInt();
						_taskTimeInfo.sTaskFile = jsonObj.value("taskFile").toString();						

						_taskTimeInfo.sLastActiveTime = jsonObj.value("lastActiveTime").toString();

						//std::cout << "loaded task time file succ." << std::endl;
						bSuccessfullyLoadedFromTaskTimeFile = true;
					}
				}

				fileTaskTimeInfo.close();

				if (bSuccessfullyLoadedFromTaskTimeFile)
				{
					if (_taskTimeInfo.iTaskPid == taskPid)
					{
						// refresh time.
						taskTimeInfo.iTaskPid = taskPid;
						taskTimeInfo.sLastActiveTime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss");
						taskTimeInfo.sTaskFile = NewFileForRun;

						
					}
					else
					{
						// calculate the time difference which is from the last active time to now?
						QDateTime dtLastActiveTime = QDateTime::fromString(_taskTimeInfo.sLastActiveTime, "yyyyMMddhhmmss");
						QDateTime dtNow = QDateTime::currentDateTime();

						int diffSecs = dtLastActiveTime.secsTo(dtNow);
						if (diffSecs > 5) // over 5 secs.
						{
							// other engine which is working on current task,may have already disappeared.
							taskTimeInfo.iTaskPid = taskPid;
							taskTimeInfo.sTaskFile = NewFileForRun;
							
							taskTimeInfo.sLastActiveTime = dtNow.toString("yyyyMMddhhmmss");
							// may have already gone.
						}
						else
						{
							// another engine is still working on current current task,don't bother it.
							std::this_thread::sleep_for(std::chrono::milliseconds(1000));
							continue;
						}
					}
				}
			}
		}
		
		if (!bSuccessfullyLoadedFromTaskTimeFile)
		{
			///std::cout << "failed to loaded task time file." << std::endl;
			taskTimeInfo.iTaskPid = taskPid;
			taskTimeInfo.sTaskFile = NewFileForRun;
			
			taskTimeInfo.sLastActiveTime = QDateTime::currentDateTime().toString("yyyyMMddhhmmss");
		}
		else
		{
			///std::cout << "loaded task time file succ2." << std::endl;
		}

		//std::cout << "after loading task time file:" << taskTimeInfo.iTaskPid << " " << taskTimeInfo.sTaskFile.toStdString() << std::endl;
		//LOGI("saveing task time file:" + std::to_string(taskTimeInfo.iTaskPid) + " " + taskTimeInfo.sTaskFile.toStdString());

		QJsonObject jsonObject;
		jsonObject.insert("taskPid",taskTimeInfo.iTaskPid);
		
		jsonObject.insert("taskFile",taskTimeInfo.sTaskFile);
		jsonObject.insert("lastActiveTime",taskTimeInfo.sLastActiveTime);

		QJsonDocument jsonDoc;
		jsonDoc.setObject(jsonObject);

		QByteArray baTaskTimeInfo = jsonDoc.toJson();

		QFile fileTaskTimeInfo(taskPidFile);
		fileTaskTimeInfo.open(QIODevice::WriteOnly);
		fileTaskTimeInfo.write(baTaskTimeInfo);
		fileTaskTimeInfo.flush();
		fileTaskTimeInfo.close();

		std::this_thread::sleep_for(std::chrono::milliseconds(1000));
	}
}

