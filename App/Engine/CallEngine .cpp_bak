//chy 查找除task_def_0.json之外的任务文件，后续改的时候注意此处
void getTaskList(const std::string& rootPath, std::vector<std::string>& filenames)
{
	namespace fs = boost::filesystem;

	try
	{
		fs::path fullpath(rootPath);
		if (!fs::exists(fullpath))
		{
			return;
		}
	}
	catch (boost::filesystem::filesystem_error& fse)
	{
		std::ostringstream oss;
		oss << "fse error:" << fse.code() << " " << fse.what() << " " << fse.path1() << " " << fse.path2();
		LOGI(oss.str());
		return;
	}
	catch (std::exception& ex)
	{
		std::ostringstream oss;
		oss << "exception:" << ex.what();
		LOGI(oss.str());
		return;
	}

	std::vector<std::string> tmp_filenames;
	
	tmp_filenames = AI3D::CORE::File::GetFileList(rootPath, JSONFILE_POSTFIX);
	//干两件事一是去除taskdef0,二是按序号排序，从某种意义上讲其实也可以按名字排序，暂时按序号吧
	std::string find_str = TASK_DEF_ZERO_FILE/*"task_def_0.json"*/;
	tmp_filenames.erase(remove_if(tmp_filenames.begin(), tmp_filenames.end(),
		[find_str](std::string n) { return n == find_str; }),
		tmp_filenames.end());

	/*fs::directory_iterator end_iter;
	for (fs::directory_iterator iter(fullpath); iter != end_iter; iter++)
	{
		if (fs::is_regular_file(iter->status())) 
		{
			std::string pathName = iter->path().string();
			std::string insertFileName = iter->path().string();
			std::replace(insertFileName.begin(), insertFileName.end(), '\\', '/');
			std::replace(pathName.begin(), pathName.end(), '\\', '/');
			pathName = pathName.substr(pathName.rfind("/") + 1, pathName.length());
			std::string lastFileName = pathName.substr(pathName.rfind(".") + 1, pathName.length());;
			
			if (pathName != "task_def_0.json" && lastFileName == "json" && pathName.find("task_def_") >= 0)
			{
				tmp_filenames.push_back(insertFileName);
			}

		}
	}*/
	//chy 为啥还要再判断一次：按序号排序
	int task_count = tmp_filenames.size();
	for (int i = 1; i <= task_count; i++) {
		std::stringstream ss;
		
		ss << "task_def_" << i << ".json";

		for (auto iter2 : tmp_filenames)
		{
			if (iter2.find(ss.str()) != std::string::npos)
			{
				filenames.push_back(iter2);
				break;
			}
		}
	}
}


//扩展时需要测试一下getlastrunning任务的返回是否正确1121

//主要处理以下情形：
//cancel：cancel由界面方主动发出，发出后立刻界面对相应的feedback文件加锁；
// 加锁后杀死运算程序，将job文件移到cancel；则本机的engine重新抢任务，而对于其他正在跑该job的机器则
// 因job文件不存在而触发判断来做相应处理以保证所有与该Job相关的节点停止对该任务的运算
//failure:一般由算法端主动发出，发出后算法端立刻对相应的feedback文件和job文件加锁；加锁后杀死运算程序，job文件到failure，
//其他正在处理该job的机器因找不到job文件而触发失败处理，此处与cc不同，cc是所有子任务都会运算一遍.

void SimpleWriteLog(std::string str)
{
	std::ostringstream oss;
	oss.clear();
	oss << str;
	LOGI(oss.str());
}

void SimpleWriteLog(QString str)
{
	std::ostringstream oss;
	oss.clear();
	oss << qstr2str(str);
	LOGI(oss.str());
}

bool LoadFeedbackFile(std::string& feedback_file, JobFeedBack_s& job_feedback, bool retry_more_times)
{
	int retryTimes = 0;
	bool bSuccessful = false;

	//qDebug() << "retry:" << retryTimes << QDateTime::currentDateTime().toString();
Retry_It:

	do
	{
		retryTimes++;

		QString feedbackFilename = QString::fromStdString(feedback_file);
		if (feedbackFilename.isEmpty())
		{
			//	qDebug() << "step 10";
			break;
		}
		QFile fileFeedback(feedbackFilename);
		if (!fileFeedback.open(QIODevice::ReadOnly))
		{
			fileFeedback.close();
			//qDebug() << "step 11";
			break;
		}

		QByteArray ba = fileFeedback.readAll();
		QJsonParseError err;
		QJsonDocument jsonDoc = QJsonDocument::fromJson(ba, &err);

		if (jsonDoc.isNull() || err.error != QJsonParseError::NoError)
		{
			fileFeedback.close();
			//qDebug() << "step 12";
			break;
		}

		fileFeedback.close();
		QJsonObject jsonObj = jsonDoc.object();
		if (!jsonObj.contains("Status") || !jsonObj.contains("Percent") || !jsonObj.contains("Msg"))
		{
			fileFeedback.close();
			//qDebug() << "step 13";;
			break;
		}

		int  status = jsonObj.value("Status").toInt();
		double percent = jsonObj.value("Percent").toDouble();
		QString msg = jsonObj.value("Msg").toString();

		//qDebug() << "step 14";
		job_feedback.Status = (jobsta_e)status;
		job_feedback.Percent = (float)percent;
		job_feedback.Msg = qstr2str(msg);

		bSuccessful = true;
	} while (false);

	if (!bSuccessful && retry_more_times && retryTimes < 3)
	{
		std::this_thread::sleep_for(std::chrono::milliseconds(2000));

		//		qDebug() << "retry:" << retryTimes << QDateTime::currentDateTime().toString();

		goto Retry_It;
	}

	if (bSuccessful)
	{
		//	qDebug() << "status/sucess:" << job_feedback.Status << job_feedback.Percent << QString::fromStdString(job_feedback.Msg);
		SimpleWriteLog("parse feedback file successfully by qjson:" + feedback_file + " retry:" + std::to_string(retryTimes));
	}
	else
	{
		//	qDebug() << "failed to parse feedback file." << retryTimes;
		SimpleWriteLog("failed to parse feedback file by qjson:" + feedback_file + " retry:" + std::to_string(retryTimes));
	}

	return bSuccessful;
}

