		}

		//std::cout << resultCode << std::endl;

		//对于失败的情形只有在程序运行完根据返回值才能知道这个时候因
		//std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
		do
		{
			FILE* fpLock = _fsopen((current_feedback_file + ".lock").c_str(), "wt", _SH_DENYWR);
			if (fpLock == NULL)
			{
				retryTimes++;
				std::this_thread::sleep_for(std::chrono::milliseconds(3000));
				continue;
			}

			///JobFeedBack_s feadback(current_feedback_file);
			JobFeedBack_s feedback;
			bool bLoadFeedbackFileError = false;

			if (!feedback.load(current_feedback_file))
			{
	///			fclose(fpLock);
				bLoadFeedbackFileError = true;
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;

				// need to retry more times?
				///return -1;
			}

			if(!bLoadFeedbackFileError && (feedback.Status == jobsta_e::STATUS_CANCLE || feedback.Status == jobsta_e::STATUS_FAILURE))
			{
				fclose(fpLock);
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
				//std::cout  << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;
				return -1;
			}	

			//在running 时的cancle和 failure会产生feedback.lock文件，如果有此文件其余的则不能写进去，但可以继续运行，task遇到这种情形则不写进去交给engine处理

		///	if (boost::filesystem::exists(current_feedback_file + ".lock"))
		///	{
		///		return -1;
		///	}

			// while reaching here,one of the algorithm functions above must have been executed successfully.
			// the 'resultCode' which means the return value of a specific algorithm function must be equal or greater than 1000.
			// among all the possible value of the 'resultCode',1000 means completed successfully,1002 means cancelled,
			// other value which must be  greater than 1000  means failed.
			feedback.TaskRetVal = resultCode;
			// todo2:

			
			feedback.Msg = resultMsg;

			// change it later,for the 'lastprogress' may have some risk while running among multiple engine nodes.
			if(bLoadFeedbackFileError || lastprogress > feedback.Percent)
				feedback.Percent = lastprogress;
			else
			{
				// keep the percent loaded from feedback file,which may be fresher than 'lastprogress'.
			}

			if (resultCode == 1000)
			{
				std::cout << "Info: Task completed ( returned : " << resultCode << " )" << " " << resultMsg << std::endl;
			
				// make some in-depth comparisons?
				// when reaching here,the feedbak status cannot be CANCELLED or Failed.
				// how to identify the source of engine which has the 'TaskRetVal' been come from,especially while multiple engines running simultaneously?

				if (bLoadFeedbackFileError || feedback.Status == jobsta_e::STATUS_PENDDING)
				{
					//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;

					feedback.Status = jobsta_e::STATUS_RUNNING;
				}
				

				// some risks rest while saving feedback file directly without locking it.
				// if already running,need to write it again?
				// no need to write running status here,it may encounter some write collisions,and it is not necessary to do it in fact.
				// just only need to write running-state once,the best opportunity to write running state is  at the same time  
				// when hold the job lock just inside 'GetPendingJob'.
				// it will also reduce concurrent collisions on feedback-file to strip duplicate writes while in running state.

				/// check it later:write progress?
				feedback.save(current_feedback_file);
			}
			else if (resultCode == 1002)
			{
				std::cout << "Info: Task cancelled ( returned : " << resultCode << " )" << " " << resultMsg << std::endl;
				/*JobFeedBack_s feadback;*/
				feedback.Status = jobsta_e::STATUS_CANCLE;

				feedback.Msg = lastMsg;

				feedback.save(current_feedback_file);

				/*FILE* fp1 = _fsopen((current_job_file + ".lock").c_str(), "wt", _SH_DENYWR);
				if (fp1 != NULL)
				{
					fclose(fp1);
				}*/
			}
			else
			{
				feedback.Msg = lastMsg;
				std::cout << "Info: Task failed ( returned : " << resultCode << " )" << " " << atparam.task_.fun_name_ << std::endl;
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__ << resultCode;

				/*JobFeedBack_s feadback;*/
				feedback.Status = jobsta_e::STATUS_FAILURE;

				feedback.save(current_feedback_file);

				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;

				// it is not necessary to lock current job at this time.

				///FILE* fp1 = _fsopen((current_job_file + ".lock").c_str(), "wt", _SH_DENYWR);
				///if (fp1 != NULL)
				///{
				///	fclose(fp1);
				///}

			}

			fclose(fpLock);
			break;
		}while (retryTimes < 3);


		//std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;
		//qDebug() << __FILE__ << __FUNCTION__ << __LINE__ << resultCode;
		///std::cout << __FILE__ << __FUNCTION__ << __LINE__ << resultCode << std::endl;
		return resultCode;
	}
	catch (boost::filesystem::filesystem_error& fse)
	{
		std::ostringstream oss;
		oss << "fse error:" << fse.code() << " " << fse.what() << " " << fse.path1() << " " << fse.path2();
		//LOGI(oss.str());
//		qDebug() << QString::fromStdString(oss.str());
		qDebug() << str2qstr(oss.str());
		std::cout << oss.str() << endl;
		return -1;
	}
	catch (std::exception ex)
	{
		qDebug() <<  __FUNCTION__ << __LINE__ << ex.what();
		///std::cout << __FILE__ << __FUNCTION__ << __LINE__ << ex.what() << std::endl;
		///return -1;
		std::cout << "Exception:" << ex.what() << std::endl;
		return 1001;
	}
}

	int doTaskInProcess(int argc, char** argv)
	{
		if (argc != 2)
		{
			// may bring confusion with some other task run status value(e.g.TASK::Failed),especially when we need the return value to perform furthur steps.  
		///	return AI3D_FAILURE;
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;

			return -1;
		}

		///QString taskJsonName = QString::fromStdString(argv[1]);
		QString taskJsonName = QString::fromLocal8Bit(argv[1]);

		QFileInfo finfo(taskJsonName);
		QString fileName = finfo.fileName();

		//qDebug() << __FILE__ << __FUNCTION__ << __LINE__ << " " << taskJsonName;
		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << " " << taskJsonName.toStdString() << std::endl;

		if (!finfo.exists() || finfo.size() <= 0)
		{
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;

			return -1;
		}

		if (!fileName.startsWith("task_def_", Qt::CaseInsensitive) ||
			!fileName.endsWith(".json", Qt::CaseInsensitive))
		{
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << std::endl;

			return -1;
		}

		return execTaskFile2Only(argv[1]);

}


std::string GetAPPPath()
{
	std::string app_path;
#ifdef _MSC_VER
	TCHAR buf[MAX_PATH + 1] = { 0 };
	GetModuleFileName(NULL, buf, MAX_PATH);
	std::string path;
	try
	{
		path = boost::filesystem::path(buf).parent_path().string();
	}
	catch (boost::filesystem::filesystem_error& fse)
	{
		std::ostringstream oss;
		oss << "fse error:" << fse.code() << " " << fse.what() << " " << fse.path1() << " " << fse.path2();
		//LOGI(oss.str());
		//qDebug() << QString::fromStdString(oss.str());
		qDebug() << str2qstr(oss.str());
		std::cout << oss.str() << endl;
	}
	catch (std::exception& ex)
	{
		qDebug() << __FUNCTION__ << __LINE__ << ex.what();
		//std::cout << __FILE__ << __FUNCTION__ << __LINE__ << ex.what() << std::endl;
	}

	return path;
#else // _MSC_VER//Linux平台待添加
	LPTSTR home = getenv("HOME");
	if (home == NULL)
		return String();
	String name(String(home) + "/app");
	return ensureUnifySlash(name);
#endif // _MSC_VER
	return app_path;
}

std::string GetGDALPath()
{
	std::string gdal_path;
	gdal_path = GetAPPPath() + "\\data";
	return gdal_path;
}
//?chy是不是不再在running搜索了
int main(int argc, char** argv)
{
	//std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;

	// test different termination signals(exit/quit,internal or external signal).
#ifdef WIN32
	SetUnhandledExceptionFilter(ExceptionFilter);
	SetConsoleCtrlHandler(HandlerRoutine, TRUE);//注册监听程序退出事件


#endif // WIN32

	::atexit(customized_exit);

	signal(SIGINT, SigInt_Handler);
	signal(SIGBREAK, SigBreak_Handler);
	signal(SIGTERM, SigBreak_Handler);
	signal(SIGABRT, SigBreak_Handler);

	QApplication app(argc, argv);

	qInstallMessageHandler(customMessageHandler);

	///UsingNoChinesePathVersion();

	int enginePid = qApp->applicationPid();
	std::string gdalDir = GetGDALPath();
	std::string strEnv = "PROJ_LIB=" + gdalDir;
	putenv(strEnv.c_str());
	GetLanguageVersion();
	//const char* paths[] = { gdalDir.c_str(),nullptr };
	//OSRSetPROJSearchPaths(paths);
	//CPLSetConfigOption("GDAL_DATA", paths[0]);
	//CPLSetConfigOption("GDAL_FILENAME_IS_UTF8","NO");//支持中文路径
	//CPLSetConfigOption("SHAPE_ENCODING","");//解决中文乱码问题
	qDebug() << "task process start.";

	int rtn = doTaskInProcess(argc, argv);
	if (rtn == -1)
	{
		std::cout << "Info: Task failed ( returned : " << -1 << " )" << std::endl;
		qDebug() << "task process failed:return -1";
	}
	else
	{
		qDebug() << "task process return:" << QString::number(rtn);
		std::cout << "task process return:" << std::to_string(rtn) << std::endl;
	}

	return rtn;
}