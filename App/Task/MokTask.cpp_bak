int execTaskFile2Only(std::string fileName)
{
	// using some functions which simulate the actual algorithms execution to test exceptional situations.
	// providing some special execution flow between master and engine to test task failing or crashing while going to extremes.
	//std::cout << __FILE__ << " " << __FUNCTION__ << " " << __LINE__ << std::endl;

	try
	{ 
		int retryTimes = 0;
		int lastDot = fileName.rfind(".json");
		int fileNamePos = fileName.rfind("task_def_");

		if (lastDot == std::string::npos || fileNamePos == std::string::npos || fileNamePos >= lastDot)
		{
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			return resultCode;
		}

		std::string taskNumStr = fileName.substr(fileNamePos + strlen("task_def_"), lastDot - fileNamePos);

		int taskdefNum = atoi(taskNumStr.c_str());
		if (taskdefNum < 0)
		{
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			return resultCode;
		}

		ATTaskInfo atparam;
		//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;

		if (!boost::filesystem::exists(fileName))
		{
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;

			return resultCode;
		}
		atparam.load(fileName);

		std::string function = atparam.task_.fun_name_;
		std::ifstream ifs(fileName);
		if (!ifs.is_open())
		{
			//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;

			std::cout << "open " + fileName + " failed" << std::endl;
			return -1;
		}

		std::string strall((std::istreambuf_iterator<char>(ifs)),
			std::istreambuf_iterator<char>());
		ifs.close();

		currentblockpath = atparam.projectFile2_;
		currentblock = atparam.blockItem2_;
		jobname = atparam.job2_;

