jobtype_e jobtype;
//status的状态在此处一直为running，其他状态有engine来更改
//进度目前的策略：如果子任务只有一个则用实时的换算，如果多余1个则只统计成功的避免频繁读写job文件
//job 不加锁，因为此处只读不写，跟cc不一样
//float fvalue : 算法返回的进度是以1为百分百
// to make sure that the following callback can be reentrant? or just called by a single thread?
void cbProgress(float fvalue)
{
	JobFeedBack_s feedback;
	JobFullInfo_s curjob;
	int retryTimes = 0;

	try
	{
		//std::cout << "cbProgress:" << fvalue << std::endl;
		//std::cout << __FUNCTION__ << " LINE " << __LINE__ << "  cbProgress " << fvalue << std::endl;
		////避免提交了cancel请求或者程序失败，此处覆盖,此处必须有current_job_file

///	if (!boost::filesystem::exists(current_feedback_file + ".lock"))
		{
			// 必须要有jobfile不然无法计算进度
		///	qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			if (!boost::filesystem::exists(current_job_file))
			{
				//std::cout << __FUNCTION__ << " LINE " << __LINE__ << "  exist current_job_file " << current_job_file << std::endl;
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
				return;
			}

			if (!curjob.load(current_job_file))
			{
				//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " load current_job_file " << current_job_file << std::endl; 
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
				return;
			}

			if (premsg != resultMsg)
			{
				// todo2:
				feedback.Msg = resultMsg;

				premsg = resultMsg;
			}

			bool bLoadFeedbackFileError = false;
			float progreestemp = 0.0;
			/*jobsta_e statustemp = jobsta_e(0);
			std::string msgtemp = "";*/

			if (!feedback.load(current_feedback_file))
			{
				//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " load current_feedback_file " << current_feedback_file << std::endl;
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
				bLoadFeedbackFileError = true;
				/// return;
			}

			if (!bLoadFeedbackFileError && (feedback.Status == jobsta_e::STATUS_CANCLE || feedback.Status == jobsta_e::STATUS_FAILURE))
			{
				//std::cout << __FUNCTION__ << " LINE " << __LINE__ << " feadback.Status " << feadback.Status << std::endl;
				//qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
				return;
			}

			progreestemp = feedback.Percent;

			// todo2:
			
		
			feedback.Msg = resultMsg;

			float currentpercent = 0;
			if (jobtype == JOB_AT /*|| jobtype== JOB_TILE*/)
			{
				currentpercent = curjob.tg.GetProgress((double)fvalue, current_task_id);;
				qDebug() <<  " progress input"<< fvalue << " progress out " << currentpercent << " taskid "<< current_task_id;
			}
			else if (jobtype == JOB_BATCH)
			{
				currentpercent = fvalue;;
			}
			else if (jobtype == JOB_TILE)
			{
				currentpercent = fvalue*100.;;
			}														 	
			if (progreestemp < currentpercent)
			{
				feedback.Percent = currentpercent;
			}
			else
			{
				// no need to assign this value indeed again.
				feedback.Percent = progreestemp;
			}

			lastprogress = feedback.Percent;

			// add lock mechanism to prevent it from  concurrent collisions on writing.
			feedback.TaskRetVal = -2;
			if (feedback.Status == jobsta_e::STATUS_PENDDING)
				feedback.Status = jobsta_e::STATUS_RUNNING;

			///qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
			// todo:check it later  whether write collision exists.
			bool a = feedback.save_with_retry(current_feedback_file, false);
			/*std::cout << __FUNCTION__ << " LINE " << __LINE__ << " save  current_feedback_file" << a << std::endl;*/
			//std::cout << "progres "<< feadback.Percent << std::endl;
			///qDebug() << __FILE__ << __FUNCTION__ << __LINE__;
		}
	}
	catch (boost::filesystem::filesystem_error& fse)
	{
		std::ostringstream oss;
		oss << "fse error:" << fse.code() << " " << fse.what() << " " << fse.path1() << " " << fse.path2();
		//LOGI(oss.str());
	//	qDebug() << QString::fromStdString(oss.str());
		qDebug() << str2qstr(oss.str());
		std::cout << oss.str() << endl;
	}
	catch (std::exception ex)
	{
		qDebug()  << __FUNCTION__ << __LINE__ << ex.what();
		std::cout  << __FUNCTION__ << __LINE__ << ex.what() << std::endl;

		return;
	}
}
void cbMsg(std::string msg)
{
	//std::cout << msg << std::endl;
	// todo2:
	// utf8?gbk?
	lastMsg = AI3D::CORE::String::LocaleToUtf8(msg);
}

static ReconstructCallBack cb([](int finish) {std::cout << "[FINISH]" << std::endl; },
	cbProgress, cbMsg, & GShoudStop);



int execTaskFile2Only(std::string fileName);
