QStackedWidget{
   background-color: #000000; 
}

QMenuBar 
{
background-color: #222222;
min-height:30px;
border:none;
font:12px "Arial";
color: #FFFFFF;
spacing: 6px;
}

QMenuBar::item {
spacing: 10px;
background: #222222;
padding: 1px 4px;
min-height:22px;
border:none;

}

QMenuBar::item:selected { /* when selected using mouse or keyboard */
background: #a8a8a8;
}

QMenuBar::item:pressed {
background: #888888;
}




QMenu {
font:12px "Arial";
color: #FFFFFF;
background-color: #777777; 
margin: 2px;

}

QMenu::item {
padding: 2px 25px 2px 20px;
border: 1px solid transparent;
color:#FFFFFF;
}
QMenu::item:selected {
    background-color:#2E598A;
}

QMenuBar::item:disabled, QMenu::item:disabled{
color: #AEAEAE;
}


QListWidget#listWidget {
border:0 px;
background: #E7E7E7; 
}

QTabBar::tab {
background: #222222;
border: 0px solid #C4C4C3;
border-bottom-color: #222222;border-top-left-radius: 3px;
border-top-right-radius: 3px;
min - width: 120px;
min-heith: 30px;padding: 0px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
/*border-image:url(:/skin/tab_selected.png);*/
/*color: #373A3C;*/
background: #333333;
}
QTabBar::tab:selected{
border-color: #9B9B9B;
border-bottom-color: #C2C7CB;
}
QTabBar::tab:!selected{
/*border-color: #9B9B9B;*/
/*border-bottom-color: #C2C7CB;*/
color: #A5A5A5;
margin-top: 2px;
margin-color:#222222;
}

QHeaderView#tableView_photogroup{
 background-color:#E7E7E7;
 border:none;
 gridline-color: #979797;
}
QTableView#tableView_photogroup
{
        border:none;
        gridline-color: #979797;
        background:#333333;
        selection- background-color:#5b5b5b;
}


QHeaderView::section {
  padding:3px; 
  margin:0px;
  border:1px solid #242424;
   border-left-width:0px;
   border-right-width:1px; 
   border-top-width:0px; 
   border-bottom-width:1px;
   background:#222222;
 }
QTableView QTableCornerButton::section {
   background: #E7E7E7;
   border: none;
}

