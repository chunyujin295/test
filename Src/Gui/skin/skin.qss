QScrollBar:vertical
{
    width:8px;
    background:rgb(0,0,0,0%);
    margin:0px,0px,0px,0px;
    padding-top:30px;   /*上预留位置*/
    padding-bottom:2px;    /*下预留位置*/
}

/*滚动条中滑块的样式*/
QScrollBar::handle:vertical
{
    width:9px;
    background:#797c84;
    border-radius:4px;
    min-height:20px;
}

/*鼠标触及滑块样式*/
QScrollBar::handle:vertical:hover
{
    width:9px;
    background:#797c84;
    border-radius:4px;
    min-height:20px;
}

/*设置下箭头*/
QScrollBar::add-line:vertical
{
    height:30px;
    width:10px;
    background:#333333;
    /*border-image:url(:/new/prefix1/skin/collapsed.png);*/
    /*subcontrol-position:bottom;*/
}

/*设置上箭头*/
QScrollBar::sub-line:vertical
{
    height:30px;
    width:10px;
     background:#333333;
    /*border-image:url(:/new/prefix1/skin/expanded.png);*/
    /*subcontrol-position:top;*/
}

/*设置下箭头:悬浮状态*/
QScrollBar::add-line:vertical:hover
{
    height:30px;
    width:10px;
    /*border-image:url(:/new/prefix1/skin/collapsed.png);
    subcontrol-position:bottom;*/
}

/*设置上箭头：悬浮状态*/
QScrollBar::sub-line:vertical:hover
{
    height:30px;
    width:10px;
    /*border-image:url(:/new/prefix1/skin/expanded.png);
    subcontrol-position:top;*/
}

/*当滚动条滚动的时候，上面的部分和下面的部分*/
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical
{
    background:rgb(0,0,0,10%);
    border-radius:4px;
}



QScrollBar:horizontal
{
    height:8px;
    background:rgb(0,0,0,0%);
    margin:0px,0px,0px,0px;
    padding-left:10px;   /*上预留位置*/
    padding-right:10px;    /*下预留位置*/
}

/*滚动条中滑块的样式*/
QScrollBar::handle:horizontal
{
    height:9px;
    background:#797c84;
    border-radius:4px;
    min-width:20px;
}

/*鼠标触及滑块样式*/
QScrollBar::handle:horizontal:hover
{
    height:9px;
    background:#797c84;
    border-radius:4px;
    min-width:20px;
}

/*设置下箭头*/
QScrollBar::add-line:horizontal
{
    height:10px;
    width:20px;
    background:#333333;
    /*border-image:url(:/new/prefix1/skin/collapsed.png);*/
    /*subcontrol-position:bottom;*/
}

/*设置上箭头*/
QScrollBar::sub-line:horizontal
{
    height:10px;
    width:20px;
     background:#333333;
    /*border-image:url(:/new/prefix1/skin/expanded.png);*/
    /*subcontrol-position:top;*/
}

/*设置下箭头:悬浮状态*/
QScrollBar::add-line:horizontal:hover
{
    height:10px;
    width:20px;
    border-image:url(:/new/prefix1/skin/collapsed.png);
    subcontrol-position:bottom;
}

/*设置上箭头：悬浮状态*/
QScrollBar::sub-line:horizontal:hover
{
    height:10px;
    width:20px;
    border-image:url(:/new/prefix1/skin/expanded.png);
    subcontrol-position:top;
}

/*当滚动条滚动的时候，上面的部分和下面的部分*/
QScrollBar::add-page:horizontal,QScrollBar::sub-page:horizontal
{
    background:#333333;
    border-radius:4px;
}




