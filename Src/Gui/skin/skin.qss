QProgressBar#progressBar_submit{
border: 2px solid grey; /*//边界色*/
border-radius: 5px; /*//边界圆滑*/
/*border:none;*/
height:30;
background: #313836;
text-align: center;
color:	#FFFFFF;
font-size:14px;

}
QProgressBar#progressBar_submit::chunk{
background-color: qlineargradient(spread:pad, x1:0, y1:0.011, x2:1, y2:0, stop:0.774011 rgba(2, 107, 72, 255), stop:1 rgba(99, 149, 103, 248));
width: 5px;
margin: 0.5px;
}

QWidget#ControlpointsWin QToolButton{
    border-width: 1px;
    border-style: solid;
    border-color: rgb(173,173,173) ;
    background-color :rgba(255,255,255,0.1);


    background-repeat:no-repeat;
    background-position:center;
/*background-image: url(:/skin/import_init.png);*/

}
QWidget#ControlpointsWin QToolButton:hover{
    border-width: 1px;
    border-style: solid;
    border-color: rgb(0,120,215) ;
    background-color :rgba(229,241,251,0.1);
}
QWidget#ControlpointsWin QToolButton:pressed{
    border-width: 1px;
    border-style: solid;
    border-color: rgb(0,84,153) ;
    background-color :rgb(204,228,247);
}


QComboBox#comboBox QAbstractItemView::item::!enabled
{
    color:rgb(0,0,0);
}
QComboBox#combo_point_coord QAbstractItemView::item::!enabled
{
    color:rgb(0,0,0);
}